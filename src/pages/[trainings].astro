---
export const prerender = true;
import Button from "@/components/Button/Button.astro";
import IframeComponent from "@/components/IframeComponent/IframeComponent.astro";
import LiveSchedule from "@/components/LiveSchedule/LiveSchedule.astro";
import PageHeader from "@/components/PageHeader/PageHeader.astro";
import siteData from "@/config/siteData.json";
import BaseLayout from "@layouts/BaseLayout.astro";
import { isInputError } from "astro:actions";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { type CollectionEntry, getCollection } from "astro:content";
import {
	CheckCheck,
	CheckCircle,
	ChevronRight,
	CornerRightDown,
	MapPin,
	Navigation,
} from "lucide-react";

export async function getStaticPaths() {
	const trainingItems = await getCollection("trainings");
	return trainingItems
		.filter((item) => !item.data.draft)
		.map((item) => ({
			params: { trainings: item.id },
			props: item,
		}));
}
type Props = CollectionEntry<"trainings">;

const item = Astro.props;
const { Content } = await render(item);
const isInstructor = item.data.isInstructor;
const isPrivateInstruction = item.id === "private-shooting-lessons-northern-va" || item.id === "one-on-one-instruction";

const isNRADefensivePistol = item.id === "nra-advanced-ccw-fairfax-va";

const nraDefensivePistolFAQs = [
	{
		question: "What gear do I need to bring to the NRA CCW Advanced Pistol Course?",
		answer: "You must bring your own personally-owned firearm, a dominant-side hip holster, a sturdy carry belt, two magazines, a mag pouch, a suitable concealment garment (such as a jacket or vest), a billed cap, and lunch. You will also need 125 rounds of ammunition, which can be purchased at the NRA Range pro shop on the day of class.",
	},
	{
		question: "Does this course satisfy Virginia concealed carry permit requirements?",
		answer: "This is an advanced skills course designed for shooters who already hold or are pursuing a Virginia Concealed Handgun Permit (CHP). It is not a standalone course for the initial permit application, but it significantly enhances the defensive competency of current permit holders. Contact us for guidance on which course best fits your training goals.",
	},
	{
		question: "Are ammo and range fees included in the $165 course price?",
		answer: "No. The $165.00 course fee covers classroom instruction and range supervision by NRA-certified instructors. Range lane fees ($15–$35) and ammunition (125 rounds required) are separate costs paid directly to the NRA Range on the day of class. Ammunition is available for purchase on-site at the NRA Range pro shop.",
	},
	{
		question: "Do I need prior shooting experience to enroll in this advanced course?",
		answer: "Yes. This is an intermediate-to-advanced level course. Students must already be comfortable handling, loading, and safely operating a semi-automatic pistol. If you are new to shooting, we recommend starting with the NRA Basic Pistol Course or First Step Pistol Orientation before attending this advanced class.",
	},
	{
		question: "What is the refund or cancellation policy for the NRA CCW Advanced Pistol Course?",
		answer: "Please contact us directly at class@livefireinstruction.com or call 1-571-210-5651 to discuss scheduling changes or cancellations prior to your course date.",
	},
];

const schemaData = isNRADefensivePistol
	? { faqs: nraDefensivePistolFAQs }
	: {
		name: item.data.title,
		description: item.data.description,
		metaDescription: item.data.meta_description,
	};

const schemaType = isNRADefensivePistol ? "faqpage" : "course";
---

<BaseLayout
	title={item.data.title.includes("|") ? item.data.title : `${item.data.title} | ${siteData.title}`}
	description={item.data.meta_description ?? item.data.description.substring(0, 160)}
	schemaData={schemaData}
	schemaType={schemaType}
>
	<div class="site-container mx-auto px-4">
		<!-- subtle background gradient effect -->
		<div
			class:list={[
				"pointer-events-none absolute top-1/2 left-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 scale-[.7] rounded-full opacity-40 blur-[100px]",
				isInstructor ? "bg-blue-200" : "bg-orange-100",
			]}
		>
		</div>
		<!-- Hero Section -->
		<header class="relative overflow-hidden pt-16 pb-24 lg:pt-24 lg:pb-32">
			<div class="relative z-[11] mx-auto max-w-4xl px-4 text-center">
				<!-- <nav aria-label="Breadcrumb" class="mb-6 flex justify-center">
					<ol role="list" class="flex items-center space-x-2 text-sm text-gray-500">
						<li>
							<a href="/" class="hover:text-primary transition-colors hover:underline"
								>Home</a
							>
						</li>
						<li>
							<ChevronRight className="h-4 w-4 text-gray-400" />
						</li>
						<li>
							<a
								href={isInstructor ? "#" : "/firearm-training-fairfax-va"}
								class="hover:text-primary transition-colors hover:underline"
								>{isInstructor ? "Instructor Courses" : "Training"}</a
							>
						</li>
						<li>
							<ChevronRight className="h-4 w-4 text-gray-400" />
						</li>
						<li>
							<span class="text-gray-900 font-medium" aria-current="page"
								>{item.data.title}</span
							>
						</li>
					</ol>
				</nav> -->
				<h1
					class="mb-6 text-2xl leading-tight font-extrabold tracking-tight text-gray-900 lg:text-4xl"
				>
					{item.data.h1_title}
				</h1>
				{item.data.subtitle && (
					<p class="mx-auto leading-relaxed max-w-2xl mb-8 md:text-xl text-gray-600 text-lg"><span class="font-semibold border-b-2 border-primary text-gray-900">{item.data.subtitle}</span></p>
				)}
				<p class="mx-auto mb-8 max-w-3xl text-lg leading-relaxed text-gray-600 md:text-xl" set:html={item.data.description} />
				{item.data.sub_description && (
					<div class="mx-auto mb-8 max-w-3xl text-base leading-relaxed text-gray-600 space-y-4" set:html={item.data.sub_description} />
				)}
			</div>

			<Button
				class:list={[
					"scroll-button m-auto mt-8 w-full max-w-max rounded-lg px-12 py-4 text-lg font-extrabold shadow-xl transition-all duration-300 hover:scale-105",
					isInstructor
						? "bg-blue-600 text-white shadow-blue-200 hover:bg-blue-700"
						: " shadow-orange-200 hover:bg-blue-700",
				]}
				variant={isInstructor ? "secondary" : "primary"}
				href="#iframe"
			>
				{item.data.button}<CornerRightDown size={18} />
			</Button>

			<div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
				{
					isInstructor && (
						<div class="flex items-center justify-center gap-2 text-sm font-medium text-gray-500">
							<CheckCircle className={isInstructor && "h-4 w-4 text-blue-600"} />
							<span>Professional Instructor Course</span>
						</div>
					)
				}
				{item.data.badgeGroup?.map((badge) => (
					<div class="flex items-center justify-center gap-2 text-sm font-medium text-gray-500">
					<CheckCircle className={isInstructor ? "h-4 w-4 text-blue-600":"h-4 w-4 text-primary-600"} />
						<span>{badge}</span>
					</div>
				))}
			</div>
		</header>

		<section class="mx-auto mb-16 max-w-6xl px-4">
			<div class="grid grid-cols-1 items-start gap-12" class:list={isInstructor ? "lg:grid-cols-1" : "lg:grid-cols-2"}>
				{
						item.data.leftColumnImage && (
						<div class="group relative">
							<div
								class="bg-primary absolute -inset-2 rounded-2xl opacity-20 blur-lg transition duration-500 group-hover:opacity-30"
							>
							</div>
							<!-- Image Section -->

								<div class="relative overflow-hidden rounded-2xl border border-gray-200 shadow-xl">
									<Image
										src={item.data.leftColumnImage}
										alt={item.data.title}
											class="h-auto w-full transform object-cover transition duration-700 group-hover:scale-105"
										/>
								</div>

						</div>
						)
				}
				<div>
					<h2 class="mb-6 flex items-center gap-3 text-2xl font-bold text-gray-900">
						<span class:list={["h-8 w-2 rounded-full", isInstructor ? "bg-blue-600" : "bg-primary"]}></span>
						{item.data.rightColumnTitle}
					</h2>
					<p class="mb-6 text-gray-600">{item.data.rightColumnDescription}</p>
					<div class="grid grid-cols-1 gap-x-4 gap-y-3">
						<div class="space-y-8">
							{
								item.data.rightColumnList?.map((listItem) => (
									<div>
										<h3 class="mb-2 text-sm font-semibold tracking-wider text-gray-400 uppercase">
											{listItem.listTitle}
										</h3>
										<ul class="grid grid-cols-1 space-y-2">
											{listItem.listItem?.map((item) => (
												<li class="flex items-start gap-3">
													<CheckCheck className={isInstructor ? "mt-0.5 h-5 w-5 text-blue-600 flex-shrink-0" : "text-primary mt-0.5 h-5 w-5 flex-shrink-0"} />
													<p set:html={item}  class="text-gray-700" />
												</li>
											))}
										</ul>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</div>
			{item.data.bottomRow && <div class="mx-auto max-w-6xl px-4">
						<div
							class="grid grid-cols-1 gap-8 overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-xl mt-8"
					>
					<!-- Info -->
					<div class="flex flex-col justify-center p-8 md:p-12">
						<div class="mb-6">
							<span class:list={["text-sm font-bold tracking-wider uppercase", isInstructor ? "text-blue-600" : "text-primary"]}>{item.data.bottomRow.title}</span>
							<p class="mt-2 text-base  text-gray-900" set:html={item.data.bottomRow.paragraph} />
						</div>
						<div class="space-y-8">
							<h3 class="mb-2 text-sm font-semibold tracking-wider text-gray-400 uppercase">
											{item.data.bottomRow.listTitle}
							</h3>
							<ul class="grid grid-cols-1 space-y-2">
							{
								item.data.bottomRow.list?.map((listItem) => (
									<li class="flex items-start gap-3">
										<CheckCheck className={isInstructor ? "mt-0.5 h-5 w-5 text-blue-600 flex-shrink-0" : "text-primary mt-0.5 h-5 w-5 flex-shrink-0"} />
										<p set:html={listItem}  class="text-gray-700" />
									</li>
								))
							}</ul>
						</div>
					</div>
				</div>
			</div>				
			}
		</section>

		{/* Live Booking Schedule */}
		<div id="iframe" class="relative border-y border-gray-200 bg-gray-50">
			<div class="bg-dots"></div>
			<div class="site-container mx-auto">
				<LiveSchedule
					category={item.id === "first-step-pistol-orientation-fairfax-va" ? "607" : (item.id === "nra-basic-pistol-shooting-course" || item.id === "nra-basic-pistol-course-fairfax-va") ? "133" : undefined}
					defaultTab={(item.id === "nra-basic-pistol-shooting-course" || item.id === "nra-basic-pistol-course-fairfax-va") ? "basic-pistol" : item.id === "first-step-pistol-orientation-fairfax-va" ? "first-steps" : "all"}
					onlyTab={(item.id === "nra-basic-pistol-shooting-course" || item.id === "nra-basic-pistol-course-fairfax-va") ? "basic-pistol" : item.id === "first-step-pistol-orientation-fairfax-va" ? "first-steps" : undefined}
				/>
			</div>
		</div>

		{/* Detailed Course Content & Laws */}
		<div id="register" class="py-12 register">
			<div class="site-container mx-auto max-w-6xl px-4 text-left prose">
				<Content />
			</div>
		</div>

		{/* Location & Facility Details */}
		{item.data.hasMap.value &&
			<section class="bg-surface border-t border-gray-200 py-20">
				<div class="mx-auto max-w-6xl px-4">
					<div
						class="grid grid-cols-1 gap-8 overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-xl md:grid-cols-2"
					>
						<!-- Info -->
						<div class="flex flex-col justify-center p-8 md:p-12">
							<div class="mb-6">
								<span class:list={["text-sm font-bold tracking-wider uppercase", isInstructor ? "text-blue-600" : "text-primary"]}>Class Location & Facility Details</span>
								<h3 class="mt-2 text-3xl font-bold text-gray-900">{item.data.hasMap.value.mapTitle}</h3>
							</div>

							<div class="space-y-6">
								<div class="flex items-start gap-4">
									<div class:list={["rounded-lg p-3", isInstructor ? "bg-blue-50 text-blue-600" : "bg-orange-50 text-primary"]}>
										<MapPin className="mt-0.5 h-5 w-5 flex-shrink-0" />
									</div>
									<div>
										{item.data.hasMap.value.address && item.data.hasMap.value.address.map((address, index) => (
											<>
											{index === 0 ? <p class="font-semibold text-gray-900">{address}</p> : <p class="text-gray-600">{address}</p>}
											</>
										))}
									</div>
									
								</div>
								<em class="text-gray-600">{item.data.hasMap.value.mapQuotes}</em>
							</div>
						</div>

						<!-- Map -->
						<div class="relative h-64 min-h-[300px] bg-gray-100 md:h-auto">
							<iframe
								class="absolute inset-0 h-full w-full opacity-80 grayscale transition duration-500 hover:opacity-100 hover:grayscale-0"
								loading="lazy"
								src={item.data.hasMap?.value.mapLink}
								title={item.data.hasMap?.value.mapTitle}
								aria-label={item.data.hasMap?.value.mapTitle}
							>
							</iframe>
						</div>
					</div>
				</div>
			</section>
		}
	</div>
</BaseLayout>

<style is:inline>
	.prose {
		@apply text-gray-700;
	}
	.prose .mt-0{
		@apply mt-0;
		margin-top: 0;
	}
	.prose h2 {
		@apply  mb-6 text-3xl font-bold text-gray-900;
	}
	.prose h3 {
		@apply mt-8 mb-4 text-2xl font-bold text-gray-900;
	}
	.prose p {
		@apply mb-4 leading-relaxed;
	}
	.prose ul,
	.prose ol {
		@apply my-6 space-y-2;
	}
	.prose li {
		@apply leading-relaxed;
	}
	.prose a {
		@apply text-primary underline transition-colors hover:text-orange-600;
	}
	.prose img {
		@apply my-8 rounded-lg shadow-md;
	}
</style>
