---
import Button from "@components/Button/Button.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import bg from "@images/404-bg.png";
import { Image } from "astro:assets";
---

<BaseLayout
	title="404 - Target Missed"
	description="Apologies, the page you're looking for is out of range. Target not found."
	noindex={true}
>
	<section
		class="relative flex min-h-[100vh] items-center justify-center overflow-hidden bg-slate-950 px-4 py-20"
	>
		<!-- Background Image with tactical overlay -->
		<div class="absolute inset-0 z-0">
			<Image
				src={bg}
				alt="Background"
				class="h-full w-full object-cover opacity-20 mix-blend-overlay contrast-125 grayscale"
			/>
			<div
				class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-950/40"
			>
			</div>
			<!-- Scanlines -->
			<div class="scanlines pointer-events-none absolute inset-0 opacity-10"></div>
		</div>

		<!-- Animated Scope Effect -->
		<div class="scope-overlay pointer-events-none absolute inset-0 z-10 opacity-30"></div>

		<div class="relative z-20 mx-auto max-w-2xl text-center">
			<div class="mb-8 inline-block">
				<div class="relative">
					<span
						class="glitch-text text-primary block text-8xl font-black tracking-tighter md:text-9xl"
						data-text="404"
					>
						404
					</span>
					<div
						class="border-primary/50 absolute -top-4 -right-4 flex h-8 w-8 animate-pulse items-center justify-center rounded-full border-2"
					>
						<div class="bg-primary h-1.5 w-1.5 rounded-full shadow-[0_0_8px_rgba(255,146,0,0.8)]">
						</div>
					</div>
				</div>
			</div>

			<h1 class="h1 mb-6 text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)]">Target Missed!</h1>

			<p class="description mx-auto mb-12 max-w-lg leading-relaxed text-slate-300">
				Apologies, the page you're searching for is out of range or has moved to a new extraction
				point. Let's get you back on target.
			</p>

			<div class="flex flex-wrap items-center justify-center gap-6">
				<Button variant="primary" href="/" arrow="right" class="px-10 py-4 text-lg">
					Return to Base
				</Button>
				<Button
					variant="outline"
					href="/firearm-training/"
					class="border-slate-700 px-10 py-4 text-lg text-white backdrop-blur-sm hover:bg-slate-800/50"
				>
					Training Courses
				</Button>
			</div>

			<div
				class="mt-20 grid grid-cols-2 gap-8 border-t border-white/5 pt-10 text-left sm:grid-cols-4"
			>
				<div>
					<h3 class="text-primary/60 text-xs font-bold tracking-[0.2em] uppercase">Intelligence</h3>
					<ul class="mt-4 space-y-3 text-sm text-slate-400">
						<li>
							<a href="/blog/" class="hover:text-primary flex items-center gap-2 transition-colors">
								Tactical Blog</a
							>
						</li>
						<li>
							<a href="/faq/" class="hover:text-primary flex items-center gap-2 transition-colors">
								Common Questions</a
							>
						</li>
					</ul>
				</div>
				<div>
					<h3 class="text-primary/60 text-xs font-bold tracking-[0.2em] uppercase">Mission</h3>
					<ul class="mt-4 space-y-3 text-sm text-slate-400">
						<li>
							<a
								href="/firearms-training-northern-virginia/"
								class="hover:text-primary flex items-center gap-2 transition-colors"
							>
								Locations</a
							>
						</li>
						<li>
							<a
								href="/contact/"
								class="hover:text-primary flex items-center gap-2 transition-colors"
							>
								Contact Us</a
							>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.glitch-text {
		position: relative;
		text-shadow:
			0.05em 0 0 rgba(255, 0, 0, 0.75),
			-0.025em -0.05em 0 rgba(0, 255, 0, 0.75),
			0.025em 0.05em 0 rgba(0, 0, 255, 0.75);
		animation: glitch 500ms infinite;
	}

	.glitch-text::before,
	.glitch-text::after {
		content: attr(data-text);
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}

	.glitch-text::before {
		animation: glitch 650ms infinite;
		clip-path: polygon(0 0, 100% 0, 100% 45%, 0 45%);
		transform: translate(-0.025em, -0.0125em);
		opacity: 0.75;
	}

	.glitch-text::after {
		animation: glitch 375ms infinite;
		clip-path: polygon(0 80%, 100% 20%, 100% 100%, 0 100%);
		transform: translate(0.0125em, 0.025em);
		opacity: 0.75;
	}

	@keyframes glitch {
		0% {
			text-shadow:
				0.05em 0 0 rgba(255, 0, 0, 0.75),
				-0.05em -0.025em 0 rgba(0, 255, 0, 0.75),
				-0.025em 0.05em 0 rgba(0, 0, 255, 0.75);
		}
		14% {
			text-shadow:
				0.05em 0 0 rgba(255, 0, 0, 0.75),
				-0.05em -0.025em 0 rgba(0, 255, 0, 0.75),
				-0.025em 0.05em 0 rgba(0, 0, 255, 0.75);
		}
		15% {
			text-shadow:
				-0.05em -0.025em 0 rgba(255, 0, 0, 0.75),
				0.025em 0.025em 0 rgba(0, 255, 0, 0.75),
				-0.05em -0.05em 0 rgba(0, 0, 255, 0.75);
		}
		49% {
			text-shadow:
				-0.05em -0.025em 0 rgba(255, 0, 0, 0.75),
				0.025em 0.025em 0 rgba(0, 255, 0, 0.75),
				-0.05em -0.05em 0 rgba(0, 0, 255, 0.75);
		}
		50% {
			text-shadow:
				0.025em 0.05em 0 rgba(255, 0, 0, 0.75),
				0.05em 0 0 rgba(0, 255, 0, 0.75),
				0 -0.05em 0 rgba(0, 0, 255, 0.75);
		}
		99% {
			text-shadow:
				0.025em 0.05em 0 rgba(255, 0, 0, 0.75),
				0.05em 0 0 rgba(0, 255, 0, 0.75),
				0 -0.05em 0 rgba(0, 0, 255, 0.75);
		}
		100% {
			text-shadow:
				-0.025em 0 0 rgba(255, 0, 0, 0.75),
				-0.025em -0.025em 0 rgba(0, 255, 0, 0.75),
				-0.025em -0.05em 0 rgba(0, 0, 255, 0.75);
		}
	}

	.scope-overlay {
		background:
			radial-gradient(circle at center, transparent 0, transparent 40%, rgba(2, 6, 23, 0.9) 70%),
			linear-gradient(rgba(255, 146, 0, 0.05) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 146, 0, 0.05) 1px, transparent 1px);
		background-size:
			100% 100%,
			80px 80px,
			80px 80px;
		animation: scope-drift 30s ease-in-out infinite alternate;
	}

	.scope-overlay::before {
		content: "";
		position: absolute;
		top: 50%;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(255, 146, 0, 0.2), transparent);
	}

	.scope-overlay::after {
		content: "";
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 1px;
		background: linear-gradient(180deg, transparent, rgba(255, 146, 0, 0.2), transparent);
	}

	@keyframes scope-drift {
		0% {
			transform: scale(1.1) translate(-3%, -3%);
		}
		100% {
			transform: scale(1.1) translate(3%, 3%);
		}
	}

	.scanlines {
		background: linear-gradient(
			to bottom,
			transparent 50%,
			rgba(0, 0, 0, 0.5) 51%,
			transparent 51%
		);
		background-size: 100% 4px;
	}
</style>
