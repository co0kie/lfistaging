---
import PageHeader from "@/components/PageHeader/PageHeader.astro";
import { CardTitle } from "@/components/ui/card";
import siteData from "@/config/siteData.json";
import CourseLayout from "@layouts/CourseLayout.astro";
import DraftBanner from "@/components/DraftBanner/DraftBanner.astro";
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import { isValidDraftPreview } from "@/utils/draftPreview";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/404");
}

const post = await getEntry("partners", slug);

if (!post) {
	return Astro.redirect("/404");
}

let isDraftPreview = false;
let previewExpiresAt: Date | undefined = undefined;

if (post.data.draft === true) {
	const authCookie = Astro.cookies.get("indexnow_auth")?.value;
	const previewCheck = isValidDraftPreview(slug, Astro.url, authCookie);

	if (!previewCheck.valid) {
		return Astro.redirect("/404");
	}

	isDraftPreview = true;
	previewExpiresAt = previewCheck.expiresAt;
}

const { Content } = await render(post);
---

{isDraftPreview && <DraftBanner expiresAt={previewExpiresAt} />}

<CourseLayout title={post.data.title + " | " + siteData.title} description={post.data.title} noindex={isDraftPreview}>
	<PageHeader title={post.data.title}>
		<hr class="bg-primary-600/50 mx-auto mt-4 max-w-[30%] rounded-full border-none pt-1" />
	</PageHeader>
	<div class="site-container mx-auto px-4 pt-16">
		<div class="text-base-content markdown-content max-w-none py-6 text-sm md:px-8 md:text-base">
			<Content />
		</div>
	</div>
</CourseLayout>

<style is:inline>
	.markdown-content img {
		width: auto;
	}
</style>
