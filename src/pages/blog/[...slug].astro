---
import BlogLayout from "@layouts/BlogLayoutSidebar.astro";
import { getEntry, render } from "astro:content";
import { isValidDraftPreview } from "@/utils/draftPreview";
import DraftBanner from "@/components/DraftBanner/DraftBanner.astro";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/404");
}

const post = await getEntry("blog", slug);

if (!post) {
	return Astro.redirect("/404");
}

let isDraftPreview = false;
let previewExpiresAt: Date | undefined = undefined;

if (post.data.draft === true) {
	const authCookie = Astro.cookies.get("indexnow_auth")?.value;
	const previewCheck = isValidDraftPreview(slug, Astro.url, authCookie);

	if (!previewCheck.valid) {
		return Astro.redirect("/404");
	}

	isDraftPreview = true;
	previewExpiresAt = previewCheck.expiresAt;
}

const { Content } = await render(post);
---

{isDraftPreview && <DraftBanner expiresAt={previewExpiresAt} />}

<BlogLayout post={post} noindex={isDraftPreview}>
	<Content />
</BlogLayout>
