---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@/components/Button/Button.astro";
import siteData from "@/config/siteData.json";
import {
	AlertCircle,
	ArrowRight,
	Calendar,
	Clock3,
	Facebook,
	Linkedin,
	Mail,
	MapPin,
	Ticket,
	Twitter,
	Users,
} from "lucide-react";
import PageHeader from "@/components/PageHeader/PageHeader.astro";

type InstructorsDashEvent = {
	id: number;
	name: string;
	tagline?: string | null;
	description?: string | null;
	address?: string | null;
	background?: string | null;
	start_date?: string | null;
	end_date?: string | null;
	available_seats?: number | null;
	short_slug?: string | null;
	ticket_items?: { price?: (number | string)[] };
};

const rawSlug = Astro.params.slug ?? "";
const normalizedSlug = rawSlug.trim().toLowerCase();
const searchID = Astro.url.searchParams.get("s");

const toSlug = (value: string) =>
	value
		.toLowerCase()
		.trim()
		.replace(/&/g, "and")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-+|-+$/g, "");

const formatDateTimeRange = (startStr?: string | null, endStr?: string | null) => {
	if (!startStr) return "";
	const start = new Date(startStr);
	const end = endStr ? new Date(endStr) : null;

	const dateOptions: Intl.DateTimeFormatOptions = {
		timeZone: "America/New_York",
		weekday: "short",
		month: "short",
		day: "numeric",
		year: "numeric",
	};

	const timeOptions: Intl.DateTimeFormatOptions = {
		timeZone: "America/New_York",
		hour: "numeric",
		minute: "2-digit",
		hour12: true,
	};

	const dateStr = start.toLocaleDateString("en-US", dateOptions);
	const startTimeStr = start.toLocaleTimeString("en-US", timeOptions);
	if (!end) return `${dateStr} | ${startTimeStr}`;
	const endTimeStr = end.toLocaleTimeString("en-US", timeOptions);
	return `${dateStr} | ${startTimeStr} - ${endTimeStr}`;
};

const fetchEventBySlug = async (
	slug: string,
	shortId?: string | null,
): Promise<InstructorsDashEvent | null> => {
	if (!slug && !shortId) return null;

	const apiBase = "https://instructorsdash.com/api/public/events/livefireinstruction";
	let apiUrl: string | null = apiBase;

	// Walk paginated results (safeguard: max 10 pages).
	for (let page = 0; page < 10 && apiUrl; page++) {
		const resp: any = await fetch(apiUrl);
		if (!resp.ok) break;
		const data = await resp.json();
		const events: InstructorsDashEvent[] = data?.events?.data ?? [];

		// Priority 1: Match exactly by short_slug if provided in query param
		if (shortId) {
			const exactMatch = events.find((e) => (e.short_slug ?? "").toLowerCase() === shortId.toLowerCase());
			if (exactMatch) return exactMatch;
		}

		// Priority 2: Match combined slug (legacy)
		const combinedMatch = events.find((e) => {
			const shortSlug = (e.short_slug ?? "").toLowerCase();
			const nameSlug = toSlug(e.name ?? "");
			const combined = shortSlug && nameSlug ? `${nameSlug}-${shortSlug}` : shortSlug || nameSlug;
			return combined === slug;
		});
		if (combinedMatch) return combinedMatch;

		// Priority 3: Match by name slug fallback
		const nameMatch = events.find((e) => toSlug(e.name ?? "") === slug);
		if (nameMatch) return nameMatch;

		apiUrl = data?.events?.next_page_url ?? null;
	}

	return null;
};

let event: InstructorsDashEvent | null = null;
let fetchError = false;

try {
	event = await fetchEventBySlug(normalizedSlug, searchID);
} catch {
	fetchError = true;
}

if (!event && !fetchError) {
	Astro.response.status = 404;
}

const pageTitle = event ? `${event.name} | ${siteData.title}` : `Class Details | ${siteData.title}`;
const pageDescription =
	event?.tagline ||
	(event ? `Details, time, and location for ${event.name}.` : "Class details could not be found.");

const heroImage = event?.background
	? `https://instructorsdash.com/storage/${event.background}`
	: null;
const price = event?.ticket_items?.price?.[0] ?? null;
const dateTime = formatDateTimeRange(event?.start_date, event?.end_date);
// https://instructorsdash.com/guest/event-register-form/${event.short_slug}?ticket=Admission+%2F+ticket%3B${event.ticket_items.price[0]}
const registrationUrl = event?.name
	? `https://instructorsdash.com/guest/event-register-form/${event.short_slug}?ticket=Admission+%2F+ticket%3B${price}`
	: `https://instructorsdash.com/e/lisa-chau/${event?.short_slug}`;

const shareUrl = Astro.url.href; // Unencoded url for encodeURIComponent below
const encodedUrl = encodeURIComponent(shareUrl);
const shareTitle = encodeURIComponent(event?.name ?? "Class Details");

const fbShare = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const xShare = `https://twitter.com/intent/tweet?text=${shareTitle}&url=${encodedUrl}`;
const emailShare = `mailto:?subject=${shareTitle}&body=${encodedUrl}`;
const linkedInShare = `https://www.linkedin.com/shareArticle?mini=true&summary=${shareTitle}&source=${encodedUrl}`;
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	schemaType="event"
	schemaData={{ name: pageTitle }}
>
	{
		fetchError ? (
			<section class="site-container px-4 pt-32 pb-20 md:pt-40">
				<div class="mx-auto max-w-3xl">
					<div class="rounded-3xl border border-red-200 bg-red-50/80 p-12 text-center shadow-xl shadow-red-900/5 backdrop-blur-sm">
						<div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-red-100 text-red-500 ring-8 ring-red-50">
							<AlertCircle size={48} />
						</div>
						<h1 class="mb-4 text-3xl font-extrabold tracking-tight text-red-950 md:text-4xl">
							Unable to Load Class Details
						</h1>
						<p class="mb-8 text-lg font-medium text-red-800">
							We ran into a problem connecting to the server. Please try again later.
						</p>
						<div class="flex justify-center">
							<Button variant="primary" href="/calendar">
								View Schedule <ArrowRight size={18} />
							</Button>
						</div>
					</div>
				</div>
			</section>
		) : !event ? (
			<section class="site-container px-4 pt-32 pb-20 md:pt-40">
				<div class="mx-auto max-w-3xl">
					<div class="rounded-3xl border border-slate-200 bg-white p-12 text-center shadow-xl shadow-slate-200/50">
						<div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-slate-100 text-slate-400 ring-8 ring-slate-50">
							<Calendar size={48} />
						</div>
						<h1 class="mb-4 text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl">
							Class Not Found
						</h1>
						<p class="mb-8 text-lg font-medium text-slate-600">
							The class you're looking for may have been removed or the link is outdated.
						</p>
						<div class="flex justify-center">
							<Button variant="primary" href="/calendar">
								View Schedule <ArrowRight size={18} />
							</Button>
						</div>
					</div>
				</div>
			</section>
		) : (
			<PageHeader title={event.name} textAlign="text-left">
				<hr class="bg-primary-600/50 ml-0 mt-4 max-w-[30%] rounded-full border-none pt-1" />
				{event.tagline && (
					<p class="text-lg text-white/80 italic md:text-xl mt-4">{event.tagline}</p>
				)}
			</PageHeader>
			<article class="bg-white pt-8 pb-20  md:pb-24">
				<div class="site-container mx-auto max-w-7xl px-4">
					<nav aria-label="Breadcrumb" class="mb-8">
						<ol role="list" class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
							<li>
								<a href="/" class="hover:text-blue hover:underline">
									Home
								</a>
							</li>
							<li class="text-slate-300">/</li>
							<li>
								<a href="/calendar" class="hover:text-blue hover:underline">
									Calendar
								</a>
							</li>
							<li class="text-slate-300">/</li>
							<li class="font-medium text-slate-900" aria-current="page">
								{event.name}
							</li>
						</ol>
					</nav>

					<div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
						<div class="space-y-8 lg:col-span-2">
							{heroImage && (
								<figure class="overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
									<img
										src={heroImage}
										alt={event.name}
										class="aspect-[16/9] w-full object-cover"
										loading="eager"
										onerror="this.src='/assets/placeholder-course.jpg'; this.onerror=null;"
									/>
								</figure>
							)}

							{event.description && (
								<div class="prose prose-slate prose-a:text-blue max-w-none">
									<div set:html={event.description} />
								</div>
							)}

							{
								event.address && (
									<h2 class="text-2xl font-bold text-slate-900">Location:</h2>
									<div class="relative h-64 min-h-[300px] bg-gray-100 md:h-auto">
										<iframe
											class="absolute inset-0 h-full w-full opacity-80 grayscale transition duration-500 hover:opacity-100 hover:grayscale-0"
											loading="lazy"
											src={"https://maps.google.it/maps?q=" + encodeURIComponent(event.address || "") + "&output=embed"}
											title={event.name}
											aria-label={event.name}
										>
										</iframe>
									</div>
								)
							}
						</div>

						{/* Sidebar */}
						<aside class="lg:col-span-1">
							<div class="space-y-6 lg:sticky lg:top-24">
								<div class="rounded-xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
									<h2 class="mb-6 border-b border-slate-200 pb-3 text-xl font-bold text-slate-900">
										Class Details
									</h2>

									<ul class="mb-8 space-y-4">
										{price != null && (
											<li class="flex items-center gap-3">
												<Ticket size={20} className="text-orange shrink-0" />
												<span class="text-lg font-medium">${price}</span>
											</li>
										)}
										{dateTime && (
											<li class="flex items-start gap-3">
												<Clock3 size={20} className="text-orange shrink-0 mt-0.5" />
												<span class="text-slate-700">{dateTime}</span>
											</li>
										)}
										{event.address && (
											<li class="flex items-start gap-3">
												<MapPin size={20} className="text-orange shrink-0 mt-0.5" />
												<span class="text-slate-700">{event.address}</span>
											</li>
										)}
										{typeof event.available_seats === "number" && (
											<li class="flex items-center gap-3">
												<Users size={20} className="text-orange shrink-0" />
												<span class="text-slate-700">{event.available_seats} seats available</span>
											</li>
										)}
									</ul>

									<div class="space-y-3">
										{registrationUrl && (
											<a
												href={registrationUrl}
												target="_blank"
												rel="noopener noreferrer"
												class="bg-orange flex w-full items-center justify-center gap-2 rounded-lg px-4 py-3 font-semibold text-white transition hover:bg-[#e65c00]"
											>
												Register Now <ArrowRight size={18} />
											</a>
										)}
										<a
											href="/calendar"
											class="flex w-full items-center justify-center rounded-lg border border-slate-300 px-4 py-3 font-medium text-slate-700 transition hover:bg-slate-200"
										>
											Back to Schedule
										</a>
									</div>
								</div>

								<div class="rounded-xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
									<h2 class="mb-4 border-b border-slate-200 pb-3 text-base font-bold text-slate-900">
										Share this Class
									</h2>
									<div class="flex flex-wrap gap-3">
										<a
											href={fbShare}
											target="_blank"
											rel="noopener noreferrer"
											class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1877F2] text-white shadow-sm transition hover:scale-105 hover:shadow focus:ring-2 focus:ring-[#1877F2] focus:ring-offset-2 active:scale-95"
											title="Share on Facebook"
										>
											<Facebook size={18} fill="currentColor" strokeWidth={0} />
										</a>
										<a
											href={xShare}
											target="_blank"
											rel="noopener noreferrer"
											class="flex h-10 w-10 items-center justify-center rounded-full bg-black text-white shadow-sm transition hover:scale-105 hover:shadow focus:ring-2 focus:ring-black focus:ring-offset-2 active:scale-95"
											title="Share on X (Twitter)"
										>
											<Twitter size={18} fill="currentColor" strokeWidth={0} />
										</a>
										<a
											href={linkedInShare}
											target="_blank"
											rel="noopener noreferrer"
											class="flex h-10 w-10 items-center justify-center rounded-full bg-[#0A66C2] text-white shadow-sm transition hover:scale-105 hover:shadow focus:ring-2 focus:ring-[#0A66C2] focus:ring-offset-2 active:scale-95"
											title="Share on LinkedIn"
										>
											<Linkedin size={18} fill="currentColor" strokeWidth={0} />
										</a>
										<a
											href={emailShare}
											class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-500 text-white shadow-sm transition hover:scale-105 hover:shadow focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 active:scale-95"
											title="Share via Email"
										>
											<Mail size={18} />
										</a>
									</div>
								</div>
							</div>
						</aside>
					</div>

					
				</div>
			</article>
		)
	}
</BaseLayout>
