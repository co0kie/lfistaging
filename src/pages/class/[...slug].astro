---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@/components/Button/Button.astro";
import siteData from "@/config/siteData.json";
import {
	AlertCircle,
	ArrowRight,
	Calendar,
	Clock3,
	Facebook,
	Linkedin,
	Mail,
	MapPin,
	Ticket,
	Twitter,
	Users,
} from "lucide-react";
import PageHeader from "@/components/PageHeader/PageHeader.astro";
import { formatDateSlug, formatClassUrl, toCourseSlug, toSlug } from "@/utils/classUrl";

type InstructorsDashEvent = {
	id: number;
	name: string;
	tagline?: string | null;
	description?: string | null;
	address?: string | null;
	background?: string | null;
	start_date?: string | null;
	end_date?: string | null;
	available_seats?: number | null;
	short_slug?: string | null;
	ticket_items?: { price?: (number | string)[] };
};

const rawSlugParam = Astro.params.slug ?? "";
const parts = rawSlugParam.split("/").filter(Boolean);

// Course part is the first segment; date part is the second segment (if present)
const coursePart = parts[0]?.trim().toLowerCase() ?? "";
const datePart = parts[1]?.trim().toLowerCase() ?? "";

const searchID = Astro.url.searchParams.get("s");

const formatDateTimeRange = (startStr?: string | null, endStr?: string | null) => {
	if (!startStr) return "";
	const start = new Date(startStr);
	const end = endStr ? new Date(endStr) : null;

	const dateOptions: Intl.DateTimeFormatOptions = {
		timeZone: "America/New_York",
		weekday: "short",
		month: "short",
		day: "numeric",
		year: "numeric",
	};

	const timeOptions: Intl.DateTimeFormatOptions = {
		timeZone: "America/New_York",
		hour: "numeric",
		minute: "2-digit",
		hour12: true,
	};

	const dateStr = start.toLocaleDateString("en-US", dateOptions);
	const startTimeStr = start.toLocaleTimeString("en-US", timeOptions);
	if (!end) return `${dateStr} | ${startTimeStr}`;
	const endTimeStr = end.toLocaleTimeString("en-US", timeOptions);
	return `${dateStr} | ${startTimeStr} - ${endTimeStr}`;
};

const fetchEventBySlug = async (
	courseSlug: string,
	dateSlug: string,
	shortId?: string | null,
): Promise<InstructorsDashEvent | null> => {
	if (!courseSlug && !dateSlug && !shortId) return null;

	const apiBase = "https://instructorsdash.com/api/public/events/livefireinstruction";
	let apiUrl: string | null = apiBase;

	let fallbackMatch: InstructorsDashEvent | null = null;

	// Walk paginated results (safeguard: max 10 pages).
	for (let page = 0; page < 10 && apiUrl; page++) {
		const resp: any = await fetch(apiUrl);
		if (!resp.ok) break;
		const data = await resp.json();
		const events: InstructorsDashEvent[] = data?.events?.data ?? [];

		// Priority 1: Match exactly by short_slug query param if provided
		if (shortId) {
			const exactMatch = events.find((e) => (e.short_slug ?? "").toLowerCase() === shortId.toLowerCase());
			if (exactMatch) return exactMatch;
		}

		for (const e of events) {
			const eDateSlug = formatDateSlug(e.start_date);
			const eShortCourseSlug = toCourseSlug(e.name ?? "");
			const eFullCourseSlug = toSlug(e.name ?? "");
			const eShortId = (e.short_slug ?? "").toLowerCase();

			const matchesCourse =
				eShortCourseSlug === courseSlug ||
				eFullCourseSlug === courseSlug ||
				eShortId === courseSlug;

			const matchesDate = dateSlug && eDateSlug === dateSlug;

			// Priority 2: Matches both course and date
			if (dateSlug && matchesCourse && matchesDate) {
				return e;
			}

			// Priority 3: Matches course if date is missing or not specified
			if (!fallbackMatch && matchesCourse) {
				fallbackMatch = e;
			}

			// Priority 4: Matches date if course slug differs slightly
			if (!fallbackMatch && dateSlug && matchesDate) {
				fallbackMatch = e;
			}
		}

		apiUrl = data?.events?.next_page_url ?? null;
	}

	return fallbackMatch;
};

let event: InstructorsDashEvent | null = null;
let fetchError = false;

try {
	event = await fetchEventBySlug(coursePart, datePart, searchID);
} catch {
	fetchError = true;
}

if (!event && !fetchError) {
	Astro.response.status = 404;
}

const canonicalUrl = event ? `${import.meta.env.SITE}${formatClassUrl(event)}` : Astro.url.href;

const pageTitle = event ? `${event.name} | ${siteData.title}` : `Class Details | ${siteData.title}`;
const pageDescription =
	event?.tagline ||
	(event ? `Details, time, and location for ${event.name}.` : "Class details could not be found.");

const heroImage = event?.background
	? `https://instructorsdash.com/storage/${event.background}`
	: null;
const price = event?.ticket_items?.price?.[0] ?? null;
const dateTime = formatDateTimeRange(event?.start_date, event?.end_date);
const registrationUrl = event?.name
	? `https://instructorsdash.com/guest/event-register-form/${event.short_slug}?ticket=Admission+%2F+ticket%3B${price}`
	: `https://instructorsdash.com/e/lisa-chau/${event?.short_slug}`;

const shareUrl = canonicalUrl;
const encodedUrl = encodeURIComponent(shareUrl);
const shareTitle = encodeURIComponent(event?.name ?? "Class Details");

const fbShare = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const xShare = `https://twitter.com/intent/tweet?text=${shareTitle}&url=${encodedUrl}`;
const emailShare = `mailto:?subject=${shareTitle}&body=${encodedUrl}`;
const linkedInShare = `https://www.linkedin.com/shareArticle?mini=true&summary=${shareTitle}&source=${encodedUrl}`;
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	schemaType="event"
	schemaData={{ name: pageTitle }}
>
	<link rel="canonical" href={canonicalUrl} slot="head" />

	{
		fetchError ? (
			<section class="site-container px-4 pt-32 pb-20 md:pt-40">
				<div class="mx-auto max-w-3xl">
					<div class="rounded-3xl border border-red-200 bg-red-50/80 p-12 text-center shadow-xl shadow-red-900/5 backdrop-blur-sm">
						<div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-red-100 text-red-500 ring-8 ring-red-50">
							<AlertCircle size={48} />
						</div>
						<h1 class="mb-4 text-3xl font-extrabold tracking-tight text-red-950 md:text-4xl">
							Unable to Load Class Details
						</h1>
						<p class="mb-8 text-lg font-medium text-red-800">
							We ran into a problem connecting to the server. Please try again later.
						</p>
						<div class="flex justify-center">
							<Button variant="primary" href="/ccw-courses-northern-va">
								View Schedule <ArrowRight size={18} />
							</Button>
						</div>
					</div>
				</div>
			</section>
		) : !event ? (
			<section class="site-container px-4 pt-32 pb-20 md:pt-40">
				<div class="mx-auto max-w-3xl">
					<div class="rounded-3xl border border-slate-200 bg-white p-12 text-center shadow-xl shadow-slate-900/5 backdrop-blur-sm">
						<div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-amber-50 text-amber-500 ring-8 ring-amber-50/50">
							<Calendar size={48} />
						</div>
						<h1 class="mb-4 text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl">
							Class Not Found
						</h1>
						<p class="mb-8 text-lg font-medium text-slate-600">
							The class you're looking for may have been removed or the link is outdated.
						</p>
						<div class="flex justify-center">
							<Button variant="primary" href="/ccw-courses-northern-va">
								View Schedule <ArrowRight size={18} />
							</Button>
						</div>
					</div>
				</div>
			</section>
		) : (
			<PageHeader title={event.name} textAlign="text-left">
				<hr class="bg-primary-600/50 ml-0 mt-4 max-w-[30%] rounded-full border-none pt-1" />
				{event.tagline && (
					<p class="mt-4 text-lg italic text-white/80 md:text-xl">{event.tagline}</p>
				)}
			</PageHeader>
			<article class="bg-white pt-8 pb-20 md:pb-24">
				<div class="site-container mx-auto max-w-7xl px-4">
					<nav aria-label="Breadcrumb" class="mb-8">
						<ol role="list" class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
							<li>
								<a href="/" class="hover:text-blue hover:underline">
									Home
								</a>
							</li>
							<li class="text-slate-300">/</li>
							<li>
								<a href="/ccw-courses-northern-va" class="hover:text-blue hover:underline">
									Calendar
								</a>
							</li>
							<li class="text-slate-300">/</li>
							<li class="font-medium text-slate-900 line-clamp-1">{event.name}</li>
						</ol>
					</nav>

					<div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
						<div class="space-y-8 lg:col-span-2">
							{heroImage && (
								<div class="relative overflow-hidden rounded-2xl bg-slate-100 shadow-md">
									<img
										src={heroImage}
										alt={event.name}
										class="max-h-[460px] w-full object-cover"
									/>
									{price && (
										<div class="bg-orange absolute top-6 right-6 rounded-full px-4 py-2 text-lg font-bold text-white shadow-md">
											${price}
										</div>
									)}
								</div>
							)}

							<div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-6 md:p-8">
								<h2 class="mb-6 text-2xl font-bold text-slate-900">Course Overview</h2>
								{event.description ? (
									<div
										class="prose max-w-none text-slate-700 leading-relaxed"
										set:html={event.description}
									/>
								) : (
									<p class="text-slate-600 italic">
										No detailed description provided for this class session. Please contact us for
										further questions or details.
									</p>
								)}
							</div>
						</div>

						<div class="space-y-6 lg:col-span-1">
							<div class="sticky top-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-xl shadow-slate-900/5 md:p-8">
								<div class="mb-6 border-b border-slate-100 pb-6">
									<p class="text-xs font-semibold tracking-wider text-slate-400 uppercase">
										Ticket Price
									</p>
									<p class="text-blue mt-1 text-3xl font-black">
										{price ? `$${price}` : "Contact for Price"}
									</p>
								</div>

								<div class="space-y-5 text-sm text-slate-600">
									{dateTime && (
										<div class="flex items-start gap-4">
											<div class="bg-primary-50 rounded-xl p-2.5 text-primary">
												<Clock3 size={20} />
											</div>
											<div>
												<p class="font-semibold text-slate-900">Date & Time</p>
												<p class="mt-0.5">{dateTime}</p>
											</div>
										</div>
									)}

									{event.address && (
										<div class="flex items-start gap-4">
											<div class="bg-primary-50 rounded-xl p-2.5 text-primary">
												<MapPin size={20} />
											</div>
											<div>
												<p class="font-semibold text-slate-900">Location</p>
												<p class="mt-0.5 leading-snug">{event.address}</p>
											</div>
										</div>
									)}

									{typeof event.available_seats === "number" && (
										<div class="flex items-start gap-4">
											<div class="bg-primary-50 rounded-xl p-2.5 text-primary">
												<Users size={20} />
											</div>
											<div>
												<p class="font-semibold text-slate-900">Availability</p>
												<p class="mt-0.5">{event.available_seats} seats remaining</p>
											</div>
										</div>
									)}
								</div>

								<div class="mt-8 space-y-3">
									{registrationUrl ? (
										<a
											href={registrationUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="bg-orange hover:bg-orange-dark flex w-full items-center justify-center gap-2 rounded-xl py-3.5 font-bold text-white shadow-md transition-all active:scale-[0.98]"
										>
											Register Now
											<Ticket size={18} />
										</a>
									) : (
										<a
											href="/contact"
											class="bg-orange flex w-full items-center justify-center gap-2 rounded-lg px-4 py-3 font-semibold text-white transition hover:bg-[#e65c00]"
										>
											Register Now <ArrowRight size={18} />
										</a>
									)}
									<a
										href="/ccw-courses-northern-va"
										class="flex w-full items-center justify-center rounded-lg border border-slate-300 px-4 py-3 font-medium text-slate-700 transition hover:bg-slate-200"
									>
										Back to Schedule
									</a>
								</div>

								<div class="mt-8 border-t border-slate-100 pt-6">
									<p class="mb-4 text-xs font-semibold tracking-wider text-slate-400 uppercase">
										Share This Class
									</p>
									<div class="flex items-center gap-3">
										<a
											href={fbShare}
											target="_blank"
											rel="noopener noreferrer"
											aria-label="Share on Facebook"
											class="hover:border-blue hover:text-blue flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 transition hover:bg-blue-50"
										>
											<Facebook size={18} />
										</a>
										<a
											href={xShare}
											target="_blank"
											rel="noopener noreferrer"
											aria-label="Share on X"
											class="hover:border-blue hover:text-blue flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 transition hover:bg-blue-50"
										>
											<Twitter size={18} />
										</a>
										<a
											href={linkedInShare}
											target="_blank"
											rel="noopener noreferrer"
											aria-label="Share on LinkedIn"
											class="hover:border-blue hover:text-blue flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 transition hover:bg-blue-50"
										>
											<Linkedin size={18} />
										</a>
										<a
											href={emailShare}
											aria-label="Share via Email"
											class="hover:border-blue hover:text-blue flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 text-slate-600 transition hover:bg-blue-50"
										>
											<Mail size={18} />
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</article>
		)
	}
</BaseLayout>
