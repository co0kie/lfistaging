---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getAllPosts } from "@js/blogUtils";
import { getCollection } from "astro:content";
import { generateDraftPreviewUrl } from "@/utils/draftPreview";
import { Send, CheckCircle2, AlertCircle, Globe, Key, List, ArrowRight, Lock, ShieldCheck, CheckSquare, Square, Filter, Eye, Clock } from "lucide-react";

// In Astro SSR, Astro.site is usually defined in astro.config.mjs
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://livefireinstruction.com";
const indexNowKey = "71928d37709f4d6e97b6309312a7b9c4";
const keyLocation = `${siteUrl}/${indexNowKey}.txt`;

// --- Authentication Logic ---
const ADMIN_PASSWORD = import.meta.env.INDEXNOW_ADMIN_PASSWORD;
let isAuthorized = Astro.cookies.get("indexnow_auth")?.value === ADMIN_PASSWORD;
let loginError = false;

// --- Page Logic (Only run if authorized) ---
let urlList: string[] = [];
let submissionResult: any = null;
let error: string | null = null;
let selectedUrls: string[] = [];

if (Astro.request.method === "POST") {
	const formData = await Astro.request.formData();
	const action = formData.get("action");
	
	if (action === "login") {
		const password = formData.get("password");
		if (password === ADMIN_PASSWORD) {
			Astro.cookies.set("indexnow_auth", ADMIN_PASSWORD as string, {
				path: "/",
				httpOnly: true,
				secure: import.meta.env.PROD,
				sameSite: "strict",
				maxAge: 60 * 60 * 24 * 7 // 1 week
			});
			return Astro.redirect(Astro.url.pathname);
		} else {
			loginError = true;
		}
	}

	if (action === "logout") {
		Astro.cookies.delete("indexnow_auth", { path: "/" });
		return Astro.redirect(Astro.url.pathname);
	}

	if (action === "submit_indexnow" && isAuthorized) {
		selectedUrls = formData.getAll("selected_urls") as string[];
		
		if (selectedUrls.length > 0) {
			try {
				const payload = {
					host: new URL(siteUrl).host,
					key: indexNowKey,
					keyLocation: keyLocation,
					urlList: selectedUrls,
				};

				const response = await fetch("https://api.indexnow.org/indexnow", {
					method: "POST",
					headers: {
						"Content-Type": "application/json; charset=utf-8",
					},
					body: JSON.stringify(payload),
				});

				submissionResult = {
					status: response.status,
					statusText: response.statusText,
					count: selectedUrls.length,
					timestamp: new Date().toLocaleString(),
				};
			} catch (e: any) {
				error = e.message;
			}
		} else {
			error = "No URLs selected for submission.";
		}
	}
}

let draftPostsWithLinks: Array<{ id: string; title: string; link1h: string; link24h: string }> = [];

if (isAuthorized) {
	// Gather URLs from various sources
	const blogPosts = await getAllPosts();
	const allBlogDrafts = await getCollection("blog", ({ data }) => data.draft === true);
	draftPostsWithLinks = allBlogDrafts.map((post) => ({
		id: post.id,
		title: post.data.title,
		link1h: generateDraftPreviewUrl(post.id, 60, siteUrl),
		link24h: generateDraftPreviewUrl(post.id, 1440, siteUrl),
	}));
	const trainings = await getCollection("trainings");
	const landingPages = await getCollection("landing", ({ data }) => data.draft !== true);
	const pages = await getCollection("pages", ({ data }) => data.draft !== true);

	// Fetch events from API (replicate sitemap-classes logic)
	let events = [];
	try {
		const response = await fetch("https://instructorsdash.com/api/public/events/livefireinstruction");
		if (response.ok) {
			const data = await response.json();
			events = data.events?.data || [];
		}
	} catch (e) {
		console.error("Failed to fetch events:", e);
	}

	const toSlug = (value: string) =>
		value
			.toLowerCase()
			.trim()
			.replace(/&/g, "and")
			.replace(/[^a-z0-9]+/g, "-")
			.replace(/^-+|-+$/g, "");

	urlList = [
		`${siteUrl}/`,
		`${siteUrl}/blog`,
		`${siteUrl}/firearm-training`,
		`${siteUrl}/calendar`,
		`${siteUrl}/partners`,
		`${siteUrl}/contact`,
		`${siteUrl}/privacy-policy`,
		`${siteUrl}/3-day-bullseye-business-blueprint-course`,
		...blogPosts.map((post) => `${siteUrl}/blog/${post.id}/`),
		...trainings.map((item) => `${siteUrl}/${item.id}`),
		...landingPages.map((item) => `${siteUrl}/${item.id}`),
		...pages.map((item) => `${siteUrl}/${item.id}`),
		...events
			.map((event: any) => {
				const nameSlug = event.name ? toSlug(event.name) : "";
				const slug = nameSlug || event.short_slug || "";
				const finalUrl = event.short_slug ? `${slug}?s=${event.short_slug}` : slug;
				if (!slug) return "";
				return `${siteUrl}/class/${finalUrl}`;
			})
			.filter((u: any) => u),
	];
}

const pageTitle = "IndexNow Submission | Live Fire Instruction Admin";
---

<BaseLayout title={pageTitle} description="Admin tool for indexing URLs via IndexNow" noindex={true}>
	<section class="bg-slate-50 py-12 md:py-20 lg:pt-32">
		<div class="site-container">
			<div class="mx-auto max-w-4xl">
				{!isAuthorized ? (
					<div class="mx-auto max-w-md">
						<div class="overflow-hidden rounded-[2.5rem] bg-white p-10 shadow-2xl ring-1 ring-slate-200">
							<div class="mb-8 text-center">
								<div class="bg-blue-dark mb-4 inline-flex h-16 w-16 items-center justify-center rounded-2xl text-orange shadow-lg">
									<Lock className="h-8 w-8" />
								</div>
								<h1 class="font-headline text-blue text-3xl font-bold">Admin Access</h1>
								<p class="mt-2 text-slate-500 text-sm">Please enter the administrator password to manage indexing.</p>
							</div>

							<form method="POST" class="space-y-6">
								<input type="hidden" name="action" value="login" />
								<div>
									<label for="password" class="mb-2 block text-xs font-bold tracking-widest text-slate-400 uppercase">Password</label>
									<input 
										type="password" 
										name="password" 
										id="password" 
										required 
										placeholder="••••••••"
										class:list={[
											"w-full rounded-2xl border bg-slate-50 px-5 py-4 text-slate-900 outline-none transition-all placeholder:text-slate-300",
											loginError ? "border-red-300 ring-4 ring-red-50" : "border-slate-200 focus:border-orange focus:ring-4 focus:ring-orange/10"
										]}
									/>
									{loginError && <p class="mt-2 text-xs font-medium text-red-500">Invalid password. Please try again.</p>}
								</div>
								
								<button 
									type="submit" 
									class="bg-blue-dark group flex w-full items-center justify-center gap-3 rounded-2xl py-4 font-bold text-white transition-all hover:bg-black active:scale-[0.98]"
								>
									<span>Unlock Dashboard</span>
									<ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
								</button>
							</form>
						</div>
					</div>
				) : (
					<>
						<header class="mb-12 text-center">
							<div
								class="bg-blue-dark text-orange mb-4 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold tracking-widest uppercase"
							>
								<Globe className="h-3.5 w-3.5" />
								SEO & Indexing
							</div>
							<h1 class="font-headline text-blue text-4xl font-bold md:text-5xl">IndexNow Engine</h1>
							<div class="mt-4 flex items-center justify-center gap-2 text-slate-600">
								<p class="text-lg">Select URLs to notify search engines about content updates.</p>
								<div class="bg-green-100 flex h-6 w-6 items-center justify-center rounded-full text-green-600">
									<ShieldCheck className="h-3.5 w-3.5" />
								</div>
							</div>
						</header>

						{
							error && (
								<div class="mb-8 flex items-start gap-4 rounded-2xl border border-red-200 bg-red-50 p-6 shadow-sm">
									<AlertCircle className="h-6 w-6 shrink-0 text-red-600" />
									<div>
										<h3 class="font-bold text-red-800">Error</h3>
										<p class="mt-1 text-red-700">{error}</p>
									</div>
								</div>
							)
						}

						{
							submissionResult && (
								<div class="mb-8 flex items-start gap-4 rounded-2xl border border-green-200 bg-green-50 p-6 shadow-sm">
									<CheckCircle2 className="h-6 w-6 shrink-0 text-green-600" />
									<div>
										<h3 class="font-bold text-green-800">Submission Successful</h3>
										<p class="mt-1 text-green-700">
											IndexNow response for <strong>{submissionResult.count} URLs</strong>:{" "}
											<strong>
												{submissionResult.status} {submissionResult.statusText}
											</strong>
										</p>
										<p class="mt-1 text-xs text-green-600">
											Processed at: {submissionResult.timestamp}
										</p>
									</div>
								</div>
							)
						}

						<form method="POST" id="indexnow-form">
							<input type="hidden" name="action" value="submit_indexnow" />
							
							<div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
								<div class="lg:col-span-8 space-y-6">
									<div class="overflow-hidden rounded-[2rem] bg-white shadow-sm ring-1 ring-slate-200">
										<div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/50 p-6">
											<h2 class="font-headline text-blue flex items-center gap-3 text-xl font-semibold">
												<List className="text-orange h-5 w-5" />
												URL Selection
											</h2>
											<div class="flex items-center gap-2">
												<button type="button" id="select-all" class="text-[10px] font-bold tracking-widest text-blue-600 uppercase hover:underline">All</button>
												<span class="text-slate-300">|</span>
												<button type="button" id="select-classes" class="text-[10px] font-bold tracking-widest text-blue-600 uppercase hover:underline">Classes Only</button>
												<span class="text-slate-300">|</span>
												<button type="button" id="select-none" class="text-[10px] font-bold tracking-widest text-blue-600 uppercase hover:underline">None</button>
											</div>
										</div>
										
										<div class="custom-scrollbar max-h-[600px] overflow-y-auto pr-2 p-6">
											<div class="space-y-1">
												{
													urlList.map((url, index) => {
														const isClass = url.includes("/class/");
														return (
															<label class="group flex cursor-pointer items-center gap-4 rounded-xl px-4 py-3 transition-colors hover:bg-slate-50">
																<div class="relative flex items-center">
																	<input 
																		type="checkbox" 
																		name="selected_urls" 
																		value={url} 
																		checked={isClass}
																		class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-slate-200 bg-white transition-all checked:border-orange checked:bg-orange focus:ring-2 focus:ring-orange/20"
																	/>
																	<CheckSquare className="pointer-events-none absolute h-5 w-5 text-white opacity-0 transition-opacity peer-checked:opacity-100" />
																</div>
																<div class="min-w-0 flex-1">
																	<p class:list={[
																		"truncate text-sm transition-colors group-hover:text-blue-900",
																		isClass ? "font-medium text-slate-900" : "text-slate-500"
																	]}>
																		{url}
																	</p>
																	{isClass && <span class="text-[9px] font-bold tracking-tighter text-orange uppercase">Regular Update</span>}
																</div>
															</label>
														);
													})
												}
											</div>
										</div>
									</div>
								</div>

								<aside class="lg:col-span-4 space-y-6">
									<div class="bg-blue-dark rounded-[2rem] p-8 text-white shadow-xl">
										<h3 class="font-headline mb-6 text-xl font-bold tracking-tight">Bulk Submit</h3>
										
										<button
											type="submit"
											class="bg-orange text-blue-dark group flex w-full items-center justify-center gap-3 rounded-2xl py-4 font-bold transition-all hover:scale-[1.02] hover:bg-white active:scale-[0.98]"
										>
											<Send className="h-5 w-5 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
											Submit Selected
										</button>

										<div class="mt-4 text-center">
											<p class="text-xs text-slate-400">IndexNow will notify all participating search engines.</p>
										</div>

										<div class="mt-8 space-y-4 border-t border-white/10 pt-6">
											<div class="flex items-center gap-3">
												<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10">
													<Filter className="text-orange h-5 w-5" />
												</div>
												<div>
													<p class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">Selected</p>
													<p class="font-mono text-sm text-white/90" id="selection-count">0 URLs</p>
												</div>
											</div>
											
											<div class="flex items-center gap-3">
												<div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10">
													<Key className="text-orange h-5 w-5" />
												</div>
												<div>
													<p class="text-[10px] font-bold tracking-widest text-slate-400 uppercase">IndexNow Key</p>
													<p class="font-mono text-sm text-white/90">{indexNowKey.substring(0, 12)}...</p>
												</div>
											</div>
										</div>
									</div>

									{draftPostsWithLinks.length > 0 && (
										<div class="rounded-[2rem] border border-amber-200 bg-amber-50/50 p-6 shadow-sm">
											<div class="mb-4 flex items-center gap-3">
												<div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-500 text-slate-950 font-bold">
													<Eye className="h-5 w-5" />
												</div>
												<div>
													<h4 class="font-headline font-bold text-amber-950 text-base">Disposable Draft Previews</h4>
													<p class="text-xs text-amber-800">Time-limited preview URLs for draft posts</p>
												</div>
											</div>
											<div class="space-y-3">
												{draftPostsWithLinks.map((item) => (
													<div class="rounded-xl border border-amber-200/80 bg-white p-4 shadow-2xs">
														<p class="font-semibold text-slate-900 text-sm line-clamp-1 mb-2">{item.title}</p>
														<div class="flex flex-wrap items-center gap-2">
															<a
																href={item.link1h}
																target="_blank"
																rel="noopener noreferrer"
																class="inline-flex items-center gap-1.5 rounded-lg bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-amber-900 transition-colors hover:bg-amber-500 hover:text-slate-950"
															>
																<Clock className="h-3.5 w-3.5" />
																<span>1 Hour Link</span>
															</a>
															<a
																href={item.link24h}
																target="_blank"
																rel="noopener noreferrer"
																class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-200"
															>
																<Clock className="h-3.5 w-3.5" />
																<span>24 Hour Link</span>
															</a>
														</div>
													</div>
												))}
											</div>
										</div>
									)}

									<div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
										<h4 class="text-blue mb-3 font-bold">Weekday Schedule</h4>
										<p class="text-sm leading-relaxed text-slate-600 italic">
											"Only class/* URLs are updated regularly (everyday weekdays). Others remain static."
										</p>
									</div>

									<form method="POST" class="mt-4">
										<input type="hidden" name="action" value="logout" />
										<button 
											type="submit" 
											class="flex w-full items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white py-3 text-sm font-semibold text-slate-500 transition-colors hover:bg-slate-50 hover:text-red-500"
										>
											Sign Out
										</button>
									</form>
								</aside>
							</div>
						</form>
					</>
				)}
			</div>
		</div>
	</section>
</BaseLayout>

<script is:inline>
	function updateCount() {
		const checkboxes = document.querySelectorAll('input[name="selected_urls"]:checked');
		const countDisplay = document.getElementById('selection-count');
		if (countDisplay) {
			countDisplay.textContent = `${checkboxes.length} URL${checkboxes.length === 1 ? '' : 's'}`;
		}
	}

	document.getElementById('select-all')?.addEventListener('click', () => {
		document.querySelectorAll('input[name="selected_urls"]').forEach(cb => cb.checked = true);
		updateCount();
	});

	document.getElementById('select-none')?.addEventListener('click', () => {
		document.querySelectorAll('input[name="selected_urls"]').forEach(cb => cb.checked = false);
		updateCount();
	});

	document.getElementById('select-classes')?.addEventListener('click', () => {
		document.querySelectorAll('input[name="selected_urls"]').forEach(cb => {
			cb.checked = cb.value.includes('/class/');
		});
		updateCount();
	});

	document.querySelectorAll('input[name="selected_urls"]').forEach(cb => {
		cb.addEventListener('change', updateCount);
	});

	// Initial count
	updateCount();
</script>

<style>
	.custom-scrollbar::-webkit-scrollbar {
		width: 4px;
	}
	.custom-scrollbar::-webkit-scrollbar-track {
		background: #f1f5f9;
		border-radius: 10px;
	}
	.custom-scrollbar::-webkit-scrollbar-thumb {
		background: #cbd5e1;
		border-radius: 10px;
	}
	.custom-scrollbar::-webkit-scrollbar-thumb:hover {
		background: #94a3b8;
</style>
