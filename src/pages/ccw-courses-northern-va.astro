---
import PageHeader from "@/components/PageHeader/PageHeader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { schemaGenerators } from "@/utils/schema";
import LiveSchedule from "@/components/LiveSchedule/LiveSchedule.astro";
import GoogleReviews from "@/components/GoogleReviews/GoogleReviews.astro";

const pageTitle = "CCW Permit Class Schedule in Fairfax, VA | Concealed Carry Course Dates";
const metaDescription =
	"View upcoming CCW permit class dates in Fairfax, VA. NRA Basic Pistol, First Step, and Advanced courses. Secure your concealed carry spot today.";

const schemaData = schemaGenerators.calendar({
	name: pageTitle,
	description: metaDescription,
	url: Astro.url.href,
});
---

<BaseLayout
	title={pageTitle}
	description={metaDescription}
	schemaType="calendar"
	schemaData={schemaData}
>
	<PageHeader title="CCW Permit Class Schedule – Fairfax Concealed Carry Course Dates">
		<hr class="bg-primary-600/50 mx-auto mt-4 max-w-[30%] rounded-full border-none pt-1" />
	</PageHeader>
	<section class="site-container px-4">
		<LiveSchedule />
		<GoogleReviews />
	</section>
</BaseLayout>
