---
import { ArrowRight } from "lucide-react";

const siteUrl = import.meta.env.SITE;
const isCalendarPage =
	Astro.url.pathname === "/calendar" ||
	Astro.url.pathname === "/ccw-courses-northern-va" ||
	Astro.url.pathname === "/ccw-courses-northern-va/" ||
	Astro.url.pathname === "/ccw-classes-fairfax-va";
interface Props {
	category?: string;
	defaultTab?: string;
	onlyTab?: string;
	title?: string | null;
	description?: string | null;
	hideHeader?: boolean;
}

const {
	category,
	defaultTab,
	onlyTab,
	title = "Get Your Virginia Concealed Carry Permit",
	description = "Gain hands-on, NRA-certified training for all experience levels at the NRA Range in Fairfax, VA.",
	hideHeader = false,
} = Astro.props;
---

<section
	id="live-schedule"
	class="bg-background/10 py-16 transition-opacity duration-500 md:py-24"
	data-category={category}
	data-default-tab={defaultTab}
	data-only-tab={onlyTab}
>
	<div class="site-container relative z-10 mx-auto">
		{
			!hideHeader && (title || description) && (
				<div class="mb-12 text-center">
					{title && (
						<h2 class="font-headline text-blue mb-4 text-3xl font-bold md:text-4xl">
							{title}
						</h2>
					)}
					{description && (
						<p class="text-muted-foreground mx-auto max-w-3xl text-lg leading-relaxed">
							{description}
						</p>
					)}
					{!isCalendarPage && (
						<a
							href={`${siteUrl}/ccw-courses-northern-va`}
							class="text-primary mt-4 inline-flex items-center gap-2 font-semibold hover:underline md:text-lg"
						>
							View Full Calendar Site
							<ArrowRight size={20} />
						</a>
					)}
				</div>
			)
		}

		{/* Category Navigation Tabs */}
		<div
			id="schedule-tabs"
			class="mb-10 hidden flex-wrap items-center justify-center gap-2.5 sm:gap-3"
		>
			<button
				type="button"
				data-tab="all"
				class="schedule-tab-btn active-tab bg-blue shadow-blue/20 ring-blue/30 flex cursor-pointer items-center gap-2.5 rounded-xl px-5 py-3 text-sm font-bold text-white shadow-md ring-2 transition-all active:scale-95"
			>
				<span>All Classes</span>
			</button>

			<button
				type="button"
				data-tab="first-steps"
				class="schedule-tab-btn hover:border-blue/40 hover:bg-blue/5 hover:text-blue flex cursor-pointer items-center gap-2.5 rounded-xl border border-gray-200 bg-white px-5 py-3 text-sm font-semibold text-gray-700 transition-all active:scale-95"
			>
				<span>First Steps Express & CCW</span>
			</button>

			<button
				type="button"
				data-tab="basic-pistol"
				class="schedule-tab-btn hover:border-blue/40 hover:bg-blue/5 hover:text-blue flex cursor-pointer items-center gap-2.5 rounded-xl border border-gray-200 bg-white px-5 py-3 text-sm font-semibold text-gray-700 transition-all active:scale-95"
			>
				<span>Basic Pistol & CCW</span>
			</button>
		</div>

		{/* Skeleton Loader - Visible while loading */}
		<div id="schedule-skeleton" class="grid grid-cols-1 gap-8 md:grid-cols-2">
			{
				[...Array(6)].map((_, i) => (
					<div class="flex animate-pulse flex-col overflow-hidden rounded-2xl border bg-white shadow-sm">
						<div class="aspect-video bg-gray-200" />
						<div class="flex flex-1 flex-col space-y-4 p-6">
							<div class="h-6 w-3/4 rounded bg-gray-200" />
							<div class="h-4 w-full rounded bg-gray-100" />
							<div class="mt-auto space-y-3">
								<div class="h-4 w-1/2 rounded bg-gray-100" />
								<div class="h-4 w-2/3 rounded bg-gray-100" />
								<div class="h-4 w-1/3 rounded bg-gray-100" />
							</div>
							<div class="mt-6 h-12 w-full rounded-xl bg-gray-200" />
						</div>
					</div>
				))
			}
		</div>

		{/* Error Message - Hidden by default */}
		<div
			id="schedule-error"
			class="hidden rounded-lg border border-red-200 bg-red-50 p-6 text-center text-red-700"
		>
			<p>Could not load upcoming classes at this time. Please check back later!</p>
		</div>

		{/* Empty Message - Hidden by default */}
		<div
			id="schedule-empty"
			class="hidden rounded-lg border border-blue-100 bg-blue-50 p-6 text-center text-blue-700"
		>
			<p>No upcoming classes found for this category at the moment. Please check back later!</p>
		</div>

		{/* Events Container - Hidden initially */}
		<div id="events-grid" class="hidden grid-cols-1 gap-8 md:grid-cols-2">
			{/* Content injected via JS */}
		</div>

		{/* Extra Events Container - Hidden initially */}
		<div id="extra-events" class="mt-8 hidden grid-cols-1 gap-8 md:grid-cols-2">
			{/* Content injected via JS */}
		</div>

		<div
			id="schedule-controls"
			class="mt-16 hidden flex-col items-center justify-center gap-6 text-center"
		>
			<button
				id="show-more-button"
				class="bg-orange hidden items-center justify-center gap-2 rounded-xl px-8 py-4 font-bold text-white shadow-lg transition-all hover:opacity-90 hover:shadow-xl active:scale-95"
			>
				Show More Classes
			</button>
		</div>
	</div>
</section>

<script>
	async function initSchedule() {
		const section = document.getElementById("live-schedule");
		const category = section?.dataset.category;
		const defaultTab = section?.dataset.defaultTab || "all";
		const onlyTab = section?.dataset.onlyTab || null;

		const skeleton = document.getElementById("schedule-skeleton");
		const eventsGrid = document.getElementById("events-grid");
		const errorEl = document.getElementById("schedule-error");
		const emptyEl = document.getElementById("schedule-empty");

		const toSlug = (value: string) =>
			value
				.toLowerCase()
				.trim()
				.replace(/&/g, "and")
				.replace(/[^a-z0-9]+/g, "-")
				.replace(/^-+|-+$/g, "");

		const toCourseSlug = (name: string) => {
			if (!name) return "";
			const lower = name.toLowerCase();
			if (lower.includes("basic pistol") || lower.includes("basics of pistol"))
				return "nra-basic-pistol-ccw-fairfax-va";
			if (lower.includes("first step")) return "nra-first-steps-ccw-fairfax-va";
			if (
				lower.includes("one-on-one") ||
				lower.includes("one on one") ||
				lower.includes("personal training")
			)
				return "one-on-one-training";
			if (
				lower.includes("defensive pistol") ||
				lower.includes("advanced pistol") ||
				(lower.includes("nra") && lower.includes("ccw") && lower.includes("course"))
			)
				return "nra-ccw-advanced";
			if (lower.includes("refuse to be a victim")) return "refuse-to-be-a-victim";
			if (lower.includes("chief range safety officer")) return "nra-crso-course";
			if (lower.includes("range safety officer")) return "nra-rso-course";
			if (lower.includes("instructor pistol")) return "nra-instructor-pistol";
			if (lower.includes("instructor rifle")) return "nra-instructor-rifle";
			if (lower.includes("instructor ccw")) return "nra-instructor-ccw";
			return toSlug(name);
		};

		const getCourseCategory = (name: string, courseSlug: string, eventCategory?: string) => {
			const lower = (name || "").toLowerCase();
			const slug = (courseSlug || "").toLowerCase();

			if (slug.includes("first-step") || lower.includes("first step")) return "first-steps";
			if (
				slug.includes("basic-pistol") ||
				lower.includes("basic pistol") ||
				lower.includes("basics of pistol")
			)
				return "basic-pistol";
			return "basic-pistol";
		};

		const formatDateSlug = (dateStr: string) => {
			if (!dateStr) return "";
			const d = new Date(dateStr);
			if (isNaN(d.getTime())) return "";
			const month = d
				.toLocaleDateString("en-US", { month: "short", timeZone: "America/New_York" })
				.toLowerCase();
			const day = d.toLocaleDateString("en-US", { day: "numeric", timeZone: "America/New_York" });
			const year = d.toLocaleDateString("en-US", { year: "numeric", timeZone: "America/New_York" });
			return `${month}-${day}-${year}`;
		};

		const getCourseMeta = (name: string) => {
			const lower = (name || "").toLowerCase();
			let shortTitle = name;
			let badges = ["NRA Certified"];

			if (lower.includes("basic pistol") || lower.includes("basics of pistol")) {
				shortTitle = "Basic Pistol Course & VA Concealed Carry Permit (An NRA Program)";
				badges = ["NRA Certified", "VA Permit Eligible"];
			} else if (lower.includes("first step")) {
				shortTitle =
					"First Steps Shooting Course & VA Concealed Carry Permit / Express Course (An NRA Program)";
				badges = ["NRA Certified", "VA Permit Eligible", "Express"];
			} else if (
				lower.includes("one-on-one") ||
				lower.includes("one on one") ||
				lower.includes("personal training")
			) {
				shortTitle = "1-on-1 Firearm Instruction";
				badges = ["Private Training", "Custom Pace"];
			} else if (
				lower.includes("defensive pistol") ||
				lower.includes("advanced pistol") ||
				(lower.includes("nra") && lower.includes("ccw"))
			) {
				shortTitle = "NRA Advanced Defensive Pistol";
				badges = ["NRA Certified", "Advanced Level"];
			} else if (lower.includes("refuse to be a victim")) {
				shortTitle = "Refuse To Be A Victim® Seminar";
				badges = ["NRA Certified", "Personal Safety"];
			} else if (lower.includes("chief range safety officer")) {
				shortTitle = "NRA Chief Range Safety Officer (CRSO)";
				badges = ["NRA Certified", "Leadership"];
			} else if (lower.includes("range safety officer")) {
				shortTitle = "NRA Range Safety Officer (RSO)";
				badges = ["NRA Certified", "Safety Specialist"];
			} else if (lower.includes("instructor pistol")) {
				shortTitle = "NRA Pistol Instructor Certification";
				badges = ["NRA Instructor", "Certification"];
			} else if (lower.includes("instructor rifle")) {
				shortTitle = "NRA Rifle Instructor Certification";
				badges = ["NRA Instructor", "Certification"];
			} else if (lower.includes("instructor ccw")) {
				shortTitle = "NRA CCW Instructor Certification";
				badges = ["NRA Instructor", "Certification"];
			} else {
				shortTitle = name
					.replace(/\s*-\s*an NRA Program/i, "")
					.replace(/\(an NRA Program\)/i, "")
					.replace(/CCW Class at NRA Range in Fairfax VA/i, "")
					.trim();
			}

			return { shortTitle, badges };
		};

		const formatSessionDate = (dateStr: string, availableSeats: number) => {
			if (!dateStr) {
				return {
					weekdayMonth: "TBA",
					dayNum: "--",
					timeShort: "",
					formattedSummary: "Date TBA",
					available_seats: availableSeats,
				};
			}
			const d = new Date(dateStr);
			if (isNaN(d.getTime())) {
				return {
					weekdayMonth: "TBA",
					dayNum: "--",
					timeShort: "",
					formattedSummary: "Date TBA",
					available_seats: availableSeats,
				};
			}

			const weekday = d
				.toLocaleDateString("en-US", { weekday: "short", timeZone: "America/New_York" })
				.toUpperCase();
			const month = d
				.toLocaleDateString("en-US", { month: "short", timeZone: "America/New_York" })
				.toUpperCase();
			const weekdayMonth = `${weekday}, ${month}`;
			const dayNum = d.toLocaleDateString("en-US", {
				day: "numeric",
				timeZone: "America/New_York",
			});
			const timeShort = d.toLocaleTimeString("en-US", {
				hour: "numeric",
				minute: "2-digit",
				hour12: true,
				timeZone: "America/New_York",
			});

			const datePart = d.toLocaleDateString("en-US", {
				weekday: "short",
				month: "short",
				day: "numeric",
				timeZone: "America/New_York",
			});
			const seatsStatus =
				availableSeats <= 0
					? "(Sold Out)"
					: availableSeats === 1
						? "(1 seat left)"
						: `(${availableSeats} seats left)`;

			const formattedSummary = `${datePart} · ${timeShort} ${seatsStatus}`;

			return {
				weekdayMonth,
				dayNum,
				timeShort,
				formattedSummary,
				available_seats: availableSeats,
			};
		};

		function groupEventsIntoMasterCards(rawEvents: any[]) {
			const map = new Map();

			for (const event of rawEvents) {
				const courseSlug = toCourseSlug(event.name || event.short_slug || "");
				if (!courseSlug) continue;

				const dateSlug = formatDateSlug(event.start_date);
				const url = dateSlug ? `/class/${courseSlug}/${dateSlug}` : `/class/${courseSlug}`;
				const seats = typeof event.available_seats === "number" ? event.available_seats : 12;
				const dateInfo = formatSessionDate(event.start_date, seats);

				const session = {
					id: event.id,
					start_date: event.start_date,
					url,
					...dateInfo,
				};

				if (!map.has(courseSlug)) {
					const { shortTitle, badges } = getCourseMeta(event.name || "");
					const courseCategory = getCourseCategory(
						event.name || "",
						courseSlug,
						event.category_name || event.category,
					);
					map.set(courseSlug, {
						courseSlug,
						category: courseCategory,
						shortTitle,
						badges,
						tagline: event.tagline || "",
						description: event.description || "",
						background: event.background || "",
						price: event.ticket_items?.price?.[0] || "0",
						address: event.address || "NRA Range, 11250 Waples Mill Road, Fairfax, VA",
						sessions: [session],
					});
				} else {
					map.get(courseSlug).sessions.push(session);
				}
			}

			return Array.from(map.values());
		}

		const renderMasterCard = (course: any) => {
			const firstSession = course.sessions[0];
			const firstUrl = firstSession ? firstSession.url : `/class/${course.courseSlug}`;
			const totalSessions = course.sessions.length;
			const hasMoreDates = totalSessions > 4;
			const remainingCount = totalSessions - 4;

			return `
				<div class="master-course-card group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all" data-course-category="${course.category}">
					<div class="relative aspect-video overflow-hidden block">
						<img
							src="https://instructorsdash.com/storage/${course.background}"
							alt="${course.shortTitle} - Live Fire Instruction"
							class="h-full w-full object-cover transition-transform duration-500 "
							loading="lazy"
							onerror="this.src='/assets/placeholder-course.jpg'; this.onerror=null;"
						/>
						<div class="bg-orange absolute top-3 right-3 rounded-full px-3.5 py-1 text-base font-extrabold text-white shadow-lg ring-2 ring-white/80">
							$${course.price}
						</div>
					</div>

					<div class="flex flex-1 flex-col p-6">
						<div class="mb-2.5 flex flex-wrap items-center gap-1.5">
							${course.badges.map((b: string) => `<span class="rounded-full bg-blue/10 px-2.5 py-0.5 text-sm font-semibold text-blue-800">${b}</span>`).join("")}
						</div>

						<h3 class="text-blue mb-2 text-2xl font-bold leading-tight">
							${course.shortTitle}
						</h3>

						<p class="text-muted-foreground mb-4 line-clamp-2 text-base italic">${course.tagline || ""}</p>

						<div class="mt-0 space-y-4 text-base text-gray-600">
							<div class="flex items-center gap-2 text-gray-600 mb-9">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
								<span class="font-medium text-base">11250 Waples Mill Road, Fairfax, VA, USA</span>
							</div>

							<div class="mt-10">
								<div class="flex-col mb-2 flex items-center justify-between sm:flex-row">
									<span class="text-sm font-bold uppercase tracking-wider text-gray-500">
										Select Class Date:
									</span>
									<span class="date-selected-summary text-sm font-semibold text-blue">
										${firstSession ? firstSession.formattedSummary : "Select Date"}
									</span>
								</div>

								<div class="flex flex-col gap-2.5" style="min-height: 15.5rem;">
									${course.sessions
										.map((s: any, idx: number) => {
											const parts = (s.weekdayMonth || "").split(", ");
											const dayName = parts[0] || "";
											const monthName = parts[1] || "";
											const isHidden = idx >= 4;
											return `
											<button
												type="button"
												data-url="${s.url}"
												data-summary="${s.formattedSummary}"
												class="date-pill-btn group/btn flex items-center justify-between rounded-xl border p-2.5 text-left transition-all cursor-pointer w-full ${isHidden ? "extra-session-pill hidden" : ""} ${
													idx === 0
														? "active-date bg-blue border-blue text-white shadow-sm font-bold ring-2 ring-blue/20"
														: "border-gray-200 bg-gray-50/80 text-gray-800"
												}"
											>
												<div class="flex items-center gap-3">
													<div class="inner-date-badge flex h-11 w-11 flex-col items-center justify-center rounded-lg border border-gray-200 bg-white transition-all">
														<span class="date-month text-[10px] font-extrabold uppercase tracking-wider ${idx === 0 ? "text-white/80" : "text-gray-500"}">${monthName}</span>
														<span class="date-day text-base font-black leading-none ${idx === 0 ? "text-white" : "text-gray-900"}">${s.dayNum}</span>
													</div>
													
													<div class="flex flex-col">
														<span class="date-weekday text-[10px] font-extrabold uppercase tracking-widest ${idx === 0 ? "text-white/80" : "text-gray-400"}">${dayName}</span>
														<span class="date-time text-sm font-semibold ${idx === 0 ? "text-white/90" : "text-gray-700"}">${s.timeShort}</span>
													</div>
												</div>
												<div class="availability-badge rounded-full px-2.5 py-1 text-xs font-bold transition-all ${
													s.available_seats <= 0
														? "bg-red-50 text-red-600 border border-red-100"
														: s.available_seats <= 3
															? "bg-amber-50 text-amber-700 border border-amber-100"
															: "bg-emerald-50 text-emerald-700 border border-emerald-100"
												}">
													${s.available_seats <= 0 ? "Sold Out" : `${s.available_seats} Left`}
												</div>
											</button>
										`;
										})
										.join("")}
								</div>

								${
									hasMoreDates
										? `
									<button
										type="button"
										class="load-more-dates-btn mt-3 flex w-full items-center justify-center gap-2 rounded-xl border border-dashed border-blue/30 bg-blue/5 py-2.5 text-xs font-bold text-blue transition-all hover:bg-blue hover:text-white hover:border-blue cursor-pointer shadow-xs active:scale-[0.98]"
									>
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="m6 9 6 6 6-6"/></svg>
										<span class="load-more-label">Load More Available Dates (${remainingCount} remaining)</span>
									</button>
								`
										: ""
								}
							</div>
						</div>

						<a
							href="${firstUrl}"
							class="master-book-btn bg-blue hover:bg-blue-dark mt-5 flex items-center justify-center gap-2 rounded-xl py-3.5 text-base font-bold text-white transition-all active:scale-[0.98] shadow-sm"
						>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
							<span>Book Selected Date</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
						</a>
					</div>
				</div>
			`;
		};

		function switchTab(tabId: string) {
			const tabBtns = document.querySelectorAll(".schedule-tab-btn");
			const cards = document.querySelectorAll(".master-course-card");
			const emptyEl = document.getElementById("schedule-empty");

			let visibleCount = 0;

			tabBtns.forEach((btn) => {
				const btnTab = (btn as HTMLElement).dataset.tab;

				if (btnTab === tabId) {
					btn.classList.add(
						"active-tab",
						"bg-blue",
						"text-white",
						"shadow-md",
						"shadow-blue/20",
						"ring-2",
						"ring-blue/30",
					);
					btn.classList.remove(
						"border",
						"border-gray-200",
						"bg-white",
						"text-gray-700",
						"hover:border-blue/40",
						"hover:bg-blue/5",
						"hover:text-blue",
					);
				} else {
					btn.classList.remove(
						"active-tab",
						"bg-blue",
						"text-white",
						"shadow-md",
						"shadow-blue/20",
						"ring-2",
						"ring-blue/30",
					);
					btn.classList.add(
						"border",
						"border-gray-200",
						"bg-white",
						"text-gray-700",
						"hover:border-blue/40",
						"hover:bg-blue/5",
						"hover:text-blue",
					);
				}
			});

			cards.forEach((card) => {
				const cardCat = (card as HTMLElement).dataset.courseCategory;
				if (tabId === "all" || cardCat === tabId) {
					card.classList.remove("hidden");
					visibleCount++;
				} else {
					card.classList.add("hidden");
				}
			});

			if (visibleCount === 0) {
				emptyEl?.classList.remove("hidden");
			} else {
				emptyEl?.classList.add("hidden");
			}
		}

		let lastPage = 1;

		async function fetchPage(page: number) {
			try {
				const apiUrl = `/api/live-schedule?page=${page}`;
				const response = await fetch(apiUrl);
				if (!response.ok) throw new Error("Fetch failed");

				const data = await response.json();
				lastPage = data.events?.last_page || 1;
				return data.events?.data || [];
			} catch (error) {
				console.error("Error loading schedule page " + page, error);
				return null;
			}
		}

		try {
			const page1Events = await fetchPage(1);
			if (page1Events === null) throw new Error("Initial fetch failed");

			let allRawEvents = [...page1Events];

			if (lastPage > 1) {
				for (let p = 2; p <= lastPage; p++) {
					const pageEvents = await fetchPage(p);
					if (pageEvents) {
						allRawEvents = [...allRawEvents, ...pageEvents];
					}
				}
			}

			if (allRawEvents.length === 0) {
				skeleton?.classList.add("hidden");
				emptyEl?.classList.remove("hidden");
				return;
			}

			const masterCourses = groupEventsIntoMasterCards(allRawEvents);

			if (eventsGrid) {
				eventsGrid.innerHTML = masterCourses.map(renderMasterCard).join("");
			}

			const tabsContainer = document.getElementById("schedule-tabs");
			tabsContainer?.classList.remove("hidden");
			tabsContainer?.classList.add("flex");

			// If onlyTab is set, hide all other category tab buttons (keep "all" visible)
			if (onlyTab) {
				document.querySelectorAll(".schedule-tab-btn").forEach((btn) => {
					const btnTab = (btn as HTMLElement).dataset.tab;
					if (btnTab !== "all" && btnTab !== onlyTab) {
						(btn as HTMLElement).style.display = "none";
					}
				});
			}

			switchTab(defaultTab);

			skeleton?.classList.add("hidden");
			eventsGrid?.classList.remove("hidden");
			eventsGrid?.classList.add("grid", "grid-cols-1", "gap-8", "md:grid-cols-2");
		} catch (error) {
			console.error("Error loading schedule:", error);
			skeleton?.classList.add("hidden");
			errorEl?.classList.remove("hidden");
		}
	}

	document.addEventListener("click", (e) => {
		const target = e.target as HTMLElement;

		const tabBtn = target.closest(".schedule-tab-btn") as HTMLButtonElement;
		if (tabBtn) {
			const tab = tabBtn.dataset.tab;
			if (tab) {
				const cards = document.querySelectorAll(".master-course-card");
				const emptyEl = document.getElementById("schedule-empty");
				let visibleCount = 0;

				document.querySelectorAll(".schedule-tab-btn").forEach((btn) => {
					const btnTab = (btn as HTMLElement).dataset.tab;
					if (btnTab === tab) {
						btn.classList.add(
							"active-tab",
							"bg-blue",
							"text-white",
							"shadow-md",
							"shadow-blue/20",
							"ring-2",
							"ring-blue/30",
						);
						btn.classList.remove(
							"border",
							"border-gray-200",
							"bg-white",
							"text-gray-700",
							"hover:border-blue/40",
							"hover:bg-blue/5",
							"hover:text-blue",
						);
					} else {
						btn.classList.remove(
							"active-tab",
							"bg-blue",
							"text-white",
							"shadow-md",
							"shadow-blue/20",
							"ring-2",
							"ring-blue/30",
						);
						btn.classList.add(
							"border",
							"border-gray-200",
							"bg-white",
							"text-gray-700",
							"hover:border-blue/40",
							"hover:bg-blue/5",
							"hover:text-blue",
						);
					}
				});

				cards.forEach((card) => {
					const cardCat = (card as HTMLElement).dataset.courseCategory;
					if (tab === "all" || cardCat === tab) {
						card.classList.remove("hidden");
						visibleCount++;
					} else {
						card.classList.add("hidden");
					}
				});

				if (visibleCount === 0) {
					emptyEl?.classList.remove("hidden");
				} else {
					emptyEl?.classList.add("hidden");
				}
			}
			return;
		}

		const loadMoreBtn = target.closest(".load-more-dates-btn") as HTMLButtonElement;
		if (loadMoreBtn) {
			const card = loadMoreBtn.closest(".master-course-card");
			if (card) {
				const hiddenPills = Array.from(card.querySelectorAll(".extra-session-pill.hidden"));
				const pillsToShow = hiddenPills.slice(0, 4);

				pillsToShow.forEach((pill) => {
					pill.classList.remove("hidden");
				});

				const remainingHidden = card.querySelectorAll(".extra-session-pill.hidden");
				if (remainingHidden.length > 0) {
					const labelSpan = loadMoreBtn.querySelector(".load-more-label");
					if (labelSpan) {
						labelSpan.textContent = `Load More Available Dates (${remainingHidden.length} remaining)`;
					}
				} else {
					loadMoreBtn.classList.add("hidden");
				}
			}
			return;
		}

		const dateBtn = target.closest(".date-pill-btn") as HTMLButtonElement;
		if (dateBtn) {
			const card = dateBtn.closest(".master-course-card");
			if (card) {
				const newUrl = dateBtn.dataset.url || "#";
				const summary = dateBtn.dataset.summary || "";

				card.querySelectorAll(".date-pill-btn").forEach((b) => {
					b.classList.remove(
						"active-date",
						"bg-blue",
						"border-blue",
						"text-white",
						"shadow-md",
						"font-bold",
						"ring-2",
						"ring-blue/20",
					);
					b.classList.add("border-gray-200", "bg-gray-50/80", "text-gray-800");

					const monthSpan = b.querySelector(".date-month");
					if (monthSpan) {
						monthSpan.classList.remove("text-white/80");
						monthSpan.classList.add("text-gray-500");
					}
					const daySpan = b.querySelector(".date-day");
					if (daySpan) {
						daySpan.classList.remove("text-white");
						daySpan.classList.add("text-gray-900");
					}
					const timeSpan = b.querySelector(".date-time");
					if (timeSpan) {
						timeSpan.classList.remove("text-white/90");
						timeSpan.classList.add("text-gray-600");
					}
				});

				dateBtn.classList.add(
					"active-date",
					"bg-blue",
					"border-blue",
					"text-white",
					"shadow-md",
					"font-bold",
					"ring-2",
					"ring-blue/20",
				);
				dateBtn.classList.remove("border-gray-200", "bg-gray-50/80", "text-gray-800");

				const monthSpan = dateBtn.querySelector(".date-month");
				if (monthSpan) {
					monthSpan.classList.add("text-white/80");
					monthSpan.classList.remove("text-gray-500");
				}
				const daySpan = dateBtn.querySelector(".date-day");
				if (daySpan) {
					daySpan.classList.add("text-white");
					daySpan.classList.remove("text-gray-900");
				}
				const timeSpan = dateBtn.querySelector(".date-time");
				if (timeSpan) {
					timeSpan.classList.add("text-white/90");
					timeSpan.classList.remove("text-gray-600");
				}

				const summaryEl = card.querySelector(".date-selected-summary");
				if (summaryEl) summaryEl.textContent = summary;

				const bookBtn = card.querySelector(".master-book-btn") as HTMLAnchorElement;
				if (bookBtn) bookBtn.href = newUrl;
			}
			return;
		}

		const bookBtn = target.closest(".master-book-btn") as HTMLAnchorElement;
		if (bookBtn) {
			if (bookBtn.classList.contains("btn-loading")) {
				e.preventDefault();
				return;
			}
			bookBtn.classList.add("btn-loading");
			bookBtn.style.pointerEvents = "none";
			bookBtn.innerHTML = `
				<svg class="book-spinner" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12a9 9 0 1 1-6.219-8.56"/>
				</svg>
				<span>Opening&hellip;</span>
			`;
		}
	});

	document.addEventListener("DOMContentLoaded", initSchedule);
	document.addEventListener("astro:after-swap", initSchedule);
</script>

<style>
	.site-container {
		width: 100%;
		max-width: 1280px;
		padding-left: 1.5rem;
		padding-right: 1.5rem;
	}
	.hidden {
		display: none;
	}
	:global(.book-spinner) {
		animation: book-spin 0.75s linear infinite;
	}
	@keyframes book-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.line-clamp-1 {
		display: -webkit-box;
		-webkit-line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	:global(.date-pill-btn.active-date .inner-date-badge) {
		background-color: rgba(255, 255, 255, 0.15) !important;
		border-color: rgba(255, 255, 255, 0.25) !important;
	}
	:global(.date-pill-btn.active-date .availability-badge) {
		background-color: rgba(255, 255, 255, 0.15) !important;
		color: #ffffff !important;
		border-color: transparent !important;
	}
</style>
