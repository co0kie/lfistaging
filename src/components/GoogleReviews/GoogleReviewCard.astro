---
import { ExternalLink, Star } from "lucide-react";

export interface Props {
	/** Reviewer Name */
	name?: string;
	/** Link to reviewer's Google profile or Google review */
	profileUrl?: string;
	/** Profile photo / picture URL */
	photoUrl?: string;
	/** Rating out of 5 (e.g. 5, 4.5) */
	rating?: number;
	/** User review excerpt text */
	text?: string;
	/** Relative date / time string (e.g. "2 weeks ago", "1 month ago") */
	relativeTime?: string;
	/** Optional character limit for excerpt. If text is longer, it will be truncated. */
	maxLength?: number;
	/** Show authentic Google G logo badge */
	showGoogleBadge?: boolean;
	/** Custom CSS class names for container */
	class?: string;
}

const {
	name = "Google User",
	profileUrl = "https://www.google.com/maps/place/Live+Fire+Instruction,+LLC/@38.1067296,-81.9706073,7z/data=!3m1!4b1!4m6!3m5!1s0x89b65c0e429587f7:0x325c91d4189983da!8m2!3d38.1319444!4d-79.3308385!16s%2Fg%2F11c2pwfqrx?entry=ttu",
	photoUrl,
	rating = 5,
	text = "Excellent firearms training! The instructors were professional, knowledgeable, and made safety the top priority.",
	relativeTime = "Recently",
	maxLength = 200,
	showGoogleBadge = true,
	class: className = "",
} = Astro.props;

// Format excerpt text if maxLength is specified
const isTruncated = maxLength && text.length > maxLength;
const displayText = isTruncated ? `${text.slice(0, maxLength).trim()}...` : text;

// Get initials for fallback avatar
const initials = name
	.split(" ")
	.map((n) => n[0])
	.join("")
	.substring(0, 2)
	.toUpperCase();

// Color array for fallback avatar background (Google style palette)
const avatarBgColors = [
	"bg-blue-600",
	"bg-red-500",
	"bg-amber-500",
	"bg-emerald-600",
	"bg-purple-600",
	"bg-indigo-600",
];
const avatarColor = avatarBgColors[name.charCodeAt(0) % avatarBgColors.length];

// Star rating array generation (1 to 5)
const stars = Array.from({ length: 5 }, (_, i) => i + 1);
---

<article
	class:list={[
		"group relative flex flex-col justify-between rounded-2xl bg-white p-6 shadow-sm border border-slate-200/90 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-slate-300",
		className,
	]}
>
	<!-- Top Header: User Profile Pic, Name, Profile Link & Google Badge -->
	<div>
		<div class="flex items-start justify-between gap-3 mb-4">
			<div class="flex items-center gap-3 min-w-0">
				<!-- User Pic / Avatar -->
				<a
					href={profileUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`View ${name}'s profile on Google`}
					class="shrink-0 transition-opacity hover:opacity-85 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded-full"
				>
					{
						photoUrl ? (
							<img
								src={photoUrl}
								alt={`${name}'s Google Profile Picture`}
								width="48"
								height="48"
								class="h-12 w-12 rounded-full object-cover border border-slate-200 shadow-xs"
								loading="lazy"
								onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';"
							/>
						) : null
					}
					<div
						class:list={[
							"h-12 w-12 rounded-full items-center justify-center font-bold text-white shadow-xs text-base tracking-wider",
							avatarColor,
							photoUrl ? "hidden" : "flex",
						]}
					>
						{initials}
					</div>
				</a>

				<!-- User Name & Profile Link -->
				<div class="min-w-0 flex-1">
					<a
						href={profileUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1.5 font-semibold text-slate-900 hover:text-blue-600 transition-colors group/link focus:outline-none focus:underline"
					>
						<span class="truncate text-base">{name}</span>
						<ExternalLink className="h-3.5 w-3.5 shrink-0 opacity-0 group-hover/link:opacity-100 transition-opacity text-blue-600" />
					</a>

					<div class="flex items-center gap-2 text-xs text-slate-500 mt-0.5">
						<span>Google Review</span>
						{relativeTime && (
							<>
								<span class="text-slate-300">•</span>
								<span>{relativeTime}</span>
							</>
						)}
					</div>
				</div>
			</div>

			<!-- Google Branding G Icon -->
			{
				showGoogleBadge && (
					<a
						href={profileUrl}
						target="_blank"
						rel="noopener noreferrer"
						title="Verified Google Review"
						class="shrink-0 rounded-full p-1.5 text-slate-400 hover:bg-slate-50 transition-colors focus:outline-none"
					>
						<svg
							class="h-6 w-6"
							viewBox="0 0 24 24"
							xmlns="http://www.w3.org/2000/svg"
							aria-hidden="true"
						>
							<path
								fill="#4285F4"
								d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
							/>
							<path
								fill="#34A853"
								d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
							/>
							<path
								fill="#FBBC05"
								d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.62z"
							/>
							<path
								fill="#EA4335"
								d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
							/>
						</svg>
					</a>
				)
			}
		</div>

		<!-- Star Rating UI -->
		<div class="flex items-center gap-2 mb-3">
			<div class="flex items-center gap-0.5 text-amber-400" aria-label={`Rating: ${rating} out of 5 stars`}>
				{
					stars.map((star) => (
						<Star
						fill="#ffb900"
							class:list={[
								"h-4 w-4 stroke-[1.5]",
								star <= Math.round(rating)
									? "fill-amber-400 text-amber-400"
									: "fill-slate-100 text-slate-300",
							]}
						/>
					))
				}
			</div>
			<span class="text-xs font-semibold text-slate-700 bg-slate-100 px-1.5 py-0.5 rounded-xs">
				{rating.toFixed(1)}
			</span>
		</div>

		<!-- User Review Excerpt -->
		<blockquote class="m-0 p-0 border-none italic text-slate-700 text-sm leading-relaxed">
			"{displayText}"
		</blockquote>
	</div>

	<!-- Bottom User Link & Excerpt Expansion CTA if truncated -->
	{
		isTruncated && (
			<div class="mt-4 pt-3 border-t border-slate-100 text-right">
				<a
					href={profileUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:underline"
				>
					Read full review on Google
					<ExternalLink className="h-3 w-3" />
				</a>
			</div>
		)
	}
</article>
