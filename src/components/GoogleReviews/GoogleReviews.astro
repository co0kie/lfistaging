---
import GoogleReviewCard from "./GoogleReviewCard.astro";
import ReviewsList, { type ReviewItem } from "./ReviewsList.astro";

interface Props {
	title?: string;
	subtitle?: string;
	reviews?: ReviewItem[];
	googleMapsUrl?: string;
	className?: string;
}

const DEFAULT_REVIEWS: ReviewItem[] = [
	{
		author_name: "James Johnston",
		author_url:
			"https://share.google/KB2h66MLcTMBoxDYk",
		rating: 5,
		review_date: "2026-05-15",
		text: "As someone who had never fired a gun before, I couldn’t have asked for a better experience than the Basic Pistol Shooting Course at Live Fire Instruction. Lisa did an excellent job leading the classroom portion of the course. She explained everything clearly and made everyone feel comfortable.",
		profile_photo_url: "https://lh3.googleusercontent.com/a-/ALV-UjUgRJv9e8MQkd8o2S6YgUytqpgkN_FaoP5im3FzAOSxLIiSx6jv=s64-c-rp-mo-ba12-br100",
	},
	{
		author_name: "InfinityAlexa",
		author_url:
			"https://share.google/6dezrjinqi3uaxIwi",
		rating: 5,
		review_date: "2026-03-15",
		text: "Was an amazing experience and great instructors. Learned a lot. The only critique would be the mass of emails after signing up for the course that say different times to arrive/ end of the class. One even said i hadn’t paid and needed to pay again through paypal. I ignored it and it was fine but still… a more cohesive singular email would be nice. The email from the instructor is what i went by at that point as it made the most sense.",
		profile_photo_url: "https://lh3.googleusercontent.com/a-/ALV-UjWI_60p0e2yUVp8DOv3nvNh0e6JbMW5TAm27q5A53Ygct6I3pfp=s64-c-rp-mo-br100",
	},
	{
		author_name: "Kenneth Young",
		author_url:
			"https://share.google/0PYwQi2NBk4N5ZdYo",
		rating: 5,
		review_date: "2026-03-15",
		text: "The course was awesome and I learned a lot about gun safety and the laws and rules. I highly recommend it for any person who wants to be thoroughly trained and educated about gun safety and usage.",
		profile_photo_url: "https://lh3.googleusercontent.com/a-/ALV-UjUeiYNVdV0SwFm5Lsu5j_3Fj0yoHNwYmbxBqe024JsQR7Lr-lNFVQ=s64-c-rp-mo-br100",
	},
	{
		author_name: "Andrew Keen",
		author_url: "https://maps.app.goo.gl/1BuLJt3F58XY89zi9",
		rating: 5,
		review_date: "2026-05-15",
		text: "I highly recommend Live Fire Instruction for anyone seeking to learn about safe and proper handling and use of firearms. I am a novice gun owner/user and Lisa clearly explained the operation and use of guns; she also approached a serious subject with an appropriate amount of humor. Her team provided hands-on instruction with handguns and gave me the confidence to return the range. I took the NRA Basic Pistol course at the NRA range in Fairfax.",
	},
	{
		author_name: "Sardar Zia",
		author_url: "https://maps.app.goo.gl/wtNEzJYPhKvQ5u3EA",
		rating: 5,
		review_date: "2026-02-15",
		text: "I had an incredible experience training at the NRA range, and Holly Bentley was the standout reason why. Holly is an exceptional instructor who truly goes above and beyond. She works tirelessly to pack every session with as much practical knowledge as possible, and her dedication to her students' success is obvious from minute one. She’s not only a hardworking professional but also a wonderful, patient person who makes learning feel natural and stress-free.",
	},
	{
		author_name: "Joe Jafari",
		author_url: "https://maps.app.goo.gl/TPVfkkdBidi2wK6h9",
		rating: 5,
		review_date: "2026-04-15",
		text: "Lisa was awesome, long class but honestly felt like a breeze. David was my range instructor too, he was a great teacher and even took time out of his day after to give me some pointers",
	},
];

const {
	title = "What Our Students Say",
	subtitle = "Real feedback from verified Google reviews",
	reviews = DEFAULT_REVIEWS,
	googleMapsUrl = "https://maps.app.goo.gl/KSTPGMJ28rx4pCNPA",
	className = "",
} = Astro.props;

const totalReviews = reviews.length;
const averageRating = totalReviews
	? (reviews.reduce((sum, r) => sum + r.rating, 0) / totalReviews).toFixed(1)
	: "5.0";
---

<section class:list={["w-full py-8", className]}>
	<div class="site-container mx-auto px-4">
		<!-- Google Reviews Summary Banner -->
		<div class="mb-10 text-center flex flex-col items-center">
			<div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-slate-800 text-sm font-semibold mb-4">
				<svg class="h-4 w-4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
					<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
					<path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.62z"></path>
					<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"></path>
				</svg>
				<span>Google Reviews</span>
				<span class="text-amber-500 font-bold">★ {averageRating}</span>
			</div>

			{title && <h2 class="text-3xl md:text-4xl font-bold text-slate-900 tracking-tight">{title}</h2>}
			{subtitle && <p class="mt-2 text-slate-600 text-base md:text-lg max-w-xl">{subtitle}</p>}
		</div>

		<!-- Reviews Grid using GoogleReviewCard -->
		<ReviewsList reviews={reviews} />

		<!-- View All on Google CTA -->
		<div class="mt-10 text-center">
			<a
				href={googleMapsUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-medium shadow-sm transition-all duration-200 hover:-translate-y-0.5"
			>
				<span>View all reviews on Google</span>
				<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
				</svg>
			</a>
		</div>
	</div>
</section>
