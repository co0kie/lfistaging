---
import GoogleReviewCard from "./GoogleReviewCard.astro";

export interface ReviewItem {
	author_name: string;
	author_url?: string;
	rating: number;
	/** ISO date string (e.g. "2025-06-15"). Used to compute relative time dynamically. */
	review_date?: string;
	/** Fallback string shown when review_date is not provided. */
	relative_time_description?: string;
	text: string;
	profile_photo_url?: string;
}

export function getRelativeTime(dateStr?: string): string | undefined {
	if (!dateStr) return undefined;
	const now = new Date();
	const then = new Date(dateStr);
	const diffMs = now.getTime() - then.getTime();
	const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
	if (diffDays < 1) return "Today";
	if (diffDays === 1) return "Yesterday";
	if (diffDays < 7) return `${diffDays} days ago`;
	const diffWeeks = Math.floor(diffDays / 7);
	if (diffWeeks === 1) return "1 week ago";
	if (diffWeeks < 5) return `${diffWeeks} weeks ago`;
	const diffMonths = Math.floor(diffDays / 30);
	if (diffMonths === 1) return "1 month ago";
	if (diffMonths === 2) return "2 months ago";
	if (diffMonths === 3) return "3 months ago";
	if (diffMonths === 4) return "4 months ago";
	if (diffMonths < 12) return `${diffMonths} months ago`;
	const diffYears = Math.floor(diffDays / 365);
	return diffYears === 1 ? "1 year ago" : `${diffYears} years ago`;
}

interface Props {
	reviews?: ReviewItem[];
	limit?: number;
	gridCols?: string;
	className?: string;
}

const { reviews = [], limit, gridCols = "grid-cols-1 md:grid-cols-2 lg:grid-cols-3", className = "" } = Astro.props;

const displayedReviews = limit ? reviews.slice(0, limit) : reviews;
---

<div class:list={["grid gap-6", gridCols, className]}>
	{
		displayedReviews.map((review) => (
			<GoogleReviewCard
				name={review.author_name}
				profileUrl={review.author_url}
				photoUrl={review.profile_photo_url}
				rating={review.rating}
				relativeTime={getRelativeTime(review.review_date) ?? review.relative_time_description}
				text={review.text}
			/>
		))
	}
</div>
