---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Card, CardContent, CardHeader, CardTitle } from "../ui/card";
import { Globe, Phone, ExternalLink, MapPin } from "lucide-react";

const recentPosts = (await getCollection("partners", ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
	{
		recentPosts.map((post) => (
			<Card className="flex flex-col overflow-hidden group shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-200 hover:border-slate-300 rounded-2xl bg-white pt-0 pb-0">
				<div class="relative h-40 w-full overflow-hidden bg-slate-100">
					{post.data.heroImage ? (
						<Image
							width={720}
							height={360}
							src={post.data.heroImage}
							alt={post.data.title}
							class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
						/>
					) : (
						<div class="flex h-full w-full items-center justify-center bg-slate-100 text-slate-400">
							<MapPin className="h-8 w-8 stroke-[1.5]" />
						</div>
					)}
					<div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
				</div>

				<CardHeader className="p-5 pb-2">
					<CardTitle className="font-headline text-lg font-bold text-slate-900 leading-snug">
						{post.data.link ? (
							<a
								href={`${post.data.link}`}
								transition:name={`blog-${post.id}`}
								class="hover:text-primary-600 transition-colors inline-flex items-center gap-1.5 group/link"
								target="_blank"
								rel="noopener noreferrer"
							>
								<span>{post.data.title}</span>
								<ExternalLink size={15} className="opacity-0 group-hover/link:opacity-100 transition-opacity text-primary-600 shrink-0" />
							</a>
						) : (
							<span>{post.data.title}</span>
						)}
					</CardTitle>
				</CardHeader>

				<CardContent className="flex flex-col justify-between flex-1 p-5 pt-0">
					<p class="text-sm text-slate-600 leading-relaxed mb-4">
						{post.data.description}
					</p>

					<div class="mt-auto pt-4 border-t border-slate-100 flex flex-col gap-2.5">
						{post.data.link && (
							<a
								href={`${post.data.link}`}
								class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 hover:text-primary-600 transition-colors"
								target="_blank"
								rel="noopener noreferrer"
								title={`${post.data.link}`}
							>
								<Globe size={15} className="text-primary-600 shrink-0" />
								<span class="truncate">{post.data.domain || post.data.link}</span>
							</a>
						)}
						{post.data.phone && (
							<a
								href={`tel:${post.data.phone}`}
								class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600 hover:text-primary-600 transition-colors"
								title={`${post.data.phone}`}
							>
								<Phone size={15} className="text-primary-600 shrink-0" />
								<span>{post.data.phone}</span>
							</a>
						)}
					</div>
				</CardContent>
			</Card>
		))
	}
</div>

