---
import { Mail, MapPin, Phone } from "lucide-react";
---

<div class="bg-blue text-white border-b border-white/10 text-xs sm:text-sm py-2 px-4 transition-colors">
	<div class="site-container flex flex-wrap items-center justify-between gap-y-2 gap-x-4">
		<!-- Address -->
		<div class="flex items-center gap-1.5 min-w-0">
			<MapPin className="h-4 w-4 shrink-0 text-orange-400" />
			<a
				href="https://maps.google.com/?q=11250+Waples+Mill+Rd,+Fairfax,+VA+22030"
				target="_blank"
				rel="noopener noreferrer"
				class="hover:text-orange-300 transition-colors truncate"
				title="NRA Range, 11250 Waples Mill Rd, Fairfax, VA 22030"
			>
				11250 Waples Mill Rd, Fairfax, VA 22030
			</a>
		</div>

		<div class="flex flex-wrap items-center gap-x-6 gap-y-1">
			<!-- Phone -->
			<div class="flex items-center gap-1.5">
				<Phone className="h-3.5 w-3.5 shrink-0 text-orange-400" />
				<a
					href="tel:1-571-210-5651"
					class="hover:text-orange-300 transition-colors"
				>
					1-571-210-5651
				</a>
			</div>

			<!-- Email -->
			<div class="flex items-center gap-1.5">
				<Mail className="h-3.5 w-3.5 shrink-0 text-orange-400" />
				<a
					href="mailto:class@livefireinstruction.com"
					class="hover:text-orange-300 transition-colors"
				>
					class@livefireinstruction.com
				</a>
			</div>
		</div>
	</div>
</div>
